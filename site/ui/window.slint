import "NotoSans-Subset.ttf";
import { App, Code, Masks } from "@app/app.slint";
import { Reveal, System, Theme } from "@app/widgets.slint";
import { PreferencesPanel } from "@app/preferences.slint";
import { Download } from "@app/components.slint";
import { Prefs } from "@app/types.slint";

export { App, Code, Masks, Reveal, System, Theme }

export component Dialog inherits Window {
    in-out property <Prefs> prefs <=> panel.prefs;
    in property <[string]> presets <=> panel.presets;
    in-out property <bool> updates <=> panel.updates;
    in-out property <string> section <=> panel.section;
    in-out property <string> ffmpeg <=> panel.ffmpeg;
    in property <bool> ffmpeg-system <=> panel.ffmpeg-system;
    in property <bool> tensorrt-shipped <=> panel.tensorrt-shipped;
    in property <[Download]> models <=> panel.models;
    in property <string> busy <=> panel.busy;
    in property <string> progress <=> panel.progress;
    in property <float> fraction <=> panel.fraction;
    background: Theme.rack;
    default-font-size: 12px;
    preferred-width: 520px;
    preferred-height: 537px;
    max-width: 100000px;
    max-height: 100000px;
    panel := PreferencesPanel { }
}
