import "NotoSans-Subset.ttf";
import { App, Code, Masks } from "@app/app.slint";
import { Button, Cell, Dropdown, FormRow, Reveal, Segment, Slider, Switch, System, Tabs, Theme } from "@app/widgets.slint";
import { Download, Parts } from "@app/components.slint";
import { Prefs } from "@app/types.slint";

export component Dialog inherits Window {
    in property <Prefs> prefs;
    in-out property <string> section: "Components";
    in property <[Download]> models <=> parts.models;
    in property <string> busy <=> parts.busy;
    in property <string> progress <=> parts.progress;
    in property <float> fraction <=> parts.fraction;
    in-out property <string> ffmpeg <=> parts.ffmpeg;
    in property <bool> ffmpeg-system <=> parts.ffmpeg-system;
    in property <bool> tensorrt-shipped <=> parts.tensorrt-shipped;
    preferred-width: 520px;
    preferred-height: 443px;
    max-width: 100000px;
    max-height: 100000px;
    background: Theme.rack;
    default-font-size: 12px;
    VerticalLayout {
        alignment: start;
        Rectangle {
            height: 40px;
            Tabs {
                x: 16px;
                width: self.preferred-width;
                label: "Section";
                options: ["General", "Projects", "Components"];
                value <=> root.section;
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.seam;
        }
        if root.section == "General": VerticalLayout {
            padding-top: 8px;
            FormRow {
                label: "Check for updates";
                Cell {
                    Switch {
                        label: "Check for updates";
                        checked: true;
                    }
                }
            }
            FormRow {
                label: "Default preset";
                Cell {
                    Dropdown {
                        label: "Default preset";
                        width: 160px;
                        height: 22px;
                        options: [root.prefs.preset];
                        value: root.prefs.preset;
                    }
                }
            }
            FormRow {
                label: "Render folder";
                Cell {
                    Button {
                        height: 22px;
                        text: "Choose…";
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: "Next to the clip";
                    color: Theme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
            FormRow {
                label: "Preview memory";
                Segment {
                    label: "Preview memory";
                    alignment: start;
                    options: ["Auto", "512 MB", "1 GB", "2 GB", "4 GB"];
                    value: "Auto";
                }
            }
            FormRow {
                label: "Smooth scrolling";
                Segment {
                    label: "Smooth scrolling";
                    alignment: start;
                    options: ["System", "On", "Off"];
                    value: "System";
                }
            }
            FormRow {
                label: "Default preview zoom";
                Slider {
                    label: "Default preview zoom";
                    minimum: 0.1;
                    maximum: 4;
                    readout: "Fit";
                    value: root.prefs.zoom;
                }
                Text {
                    width: 38px;
                    text: "Fit";
                    color: Theme.ink;
                    font-size: 12px;
                    font-family: "monospace";
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
            FormRow {
                label: "Confirm removal";
                Cell {
                    Switch {
                        label: "Confirm removal";
                        checked: root.prefs.confirm-delete;
                    }
                }
            }
            FormRow {
                label: "Auto fit timeline to clips";
                Cell {
                    Switch {
                        label: "Auto fit timeline to clips";
                        checked: root.prefs.autofit;
                    }
                }
            }
            FormRow {
                label: "Ripple delete by default";
                Cell {
                    Switch {
                        label: "Ripple delete by default";
                        checked: root.prefs.ripple;
                    }
                }
            }
        }
        if root.section == "Projects": VerticalLayout {
            padding-top: 8px;
            FormRow {
                label: "Project files";
                Cell {
                    Switch {
                        label: "Project files";
                        checked: root.prefs.projects;
                    }
                }
            }
            FormRow {
                label: "Autosave";
                Segment {
                    label: "Autosave";
                    alignment: start;
                    options: ["Off", "1 min", "5 min", "10 min"];
                    value: root.prefs.autosave == 0 ? "Off" : "\{root.prefs.autosave} min";
                }
            }
            FormRow {
                label: "Ask to save";
                Cell {
                    Switch {
                        label: "Ask to save";
                        checked: root.prefs.ask-save;
                    }
                }
            }
            FormRow {
                label: "Reopen last project";
                Cell {
                    Switch {
                        label: "Reopen last project";
                        checked: root.prefs.reopen;
                    }
                }
            }
        }
        parts := Parts {
            visible: root.section == "Components";
            height: root.section == "Components" ? self.preferred-height : 0px;
        }
    }
}

export { App, Code, Masks, Reveal, System, Theme }
