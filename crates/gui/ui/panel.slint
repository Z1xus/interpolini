import { Action, Button, Dropdown, Field, FileButtons, Focus, Icon, Icons, Label, MenuItem, MenuPopup, Note, Number, Popups, Row, Scroll, Section, Segment, SliderRow, Switch, Theme } from "widgets.slint";
import { Clip, Masks, MaskTile, Mode, Munch, Sections, Settings } from "types.slint";

component Curve inherits Rectangle {
    in property <[float]> weights;
    in property <string> summary;
    height: root.weights.length > 0 ? 76px : 24px;
    accessible-role: image;
    accessible-label: root.summary;
    HorizontalLayout {
        x: 28px;
        y: 4px;
        width: parent.width - 40px;
        height: 44px;
        spacing: 1px;
        for weight in root.weights: Rectangle {
            Rectangle {
                y: parent.height - self.height;
                height: max(1px, weight * parent.height);
                background: Theme.accent;
            }
        }
    }
    Text {
        x: 28px;
        y: root.weights.length > 0 ? 54px : 4px;
        text: root.summary;
        color: Theme.faint;
        font-size: 11px;
        font-family: "monospace";
        accessible-role: none;
    }
}

export global Code {
    in property <[string]> words;
    in property <string> about;
    in property <string> result;
    in property <bool> valid;
    in property <bool> bad;
    callback share();
    callback copy();
    callback check(string);
    callback apply(string);
}

component MaskGrid inherits Rectangle {
    in property <string> chosen;
    in-out property <string> renaming;
    callback choose(string);
    callback menu(MaskTile, length, length);
    callback add(length, length);
    property <int> columns: 3;
    property <length> gap: 8px;
    property <length> tile: (self.width - (self.columns - 1) * self.gap) / self.columns;
    property <length> picture: self.tile * 9 / 16;
    property <length> step: self.picture + 20px;
    property <bool> empty: Masks.list.length == 0;
    property <bool> alone: mod(Masks.list.length, self.columns) == 0;
    height: ceil((Masks.list.length + 1) / self.columns) * (self.step + self.gap) - self.gap - (self.alone ? self.step - self.picture : 0px);
    accessible-role: radio-group;
    accessible-label: "Mask";
    for mask[index] in Masks.list: Rectangle {
        property <bool> active: mask.name == root.chosen;
        x: mod(index, root.columns) * (root.tile + root.gap);
        y: floor(index / root.columns) * (root.step + root.gap);
        width: root.tile;
        height: root.step;
        accessible-role: radio-button;
        accessible-label: mask.name;
        accessible-checkable: true;
        accessible-checked: self.active;
        accessible-item-index: index;
        accessible-item-count: Masks.list.length;
        accessible-action-default => {
            root.choose(mask.name);
        }
        Focus {
            activate => {
                root.choose(mask.name);
            }
            more(event) => {
                if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                    root.menu(mask, parent.absolute-position.x, parent.absolute-position.y + parent.height);
                    return accept;
                }
                reject
            }
        }
        Rectangle {
            y: 0;
            height: root.picture;
            border-width: 1px;
            border-color: parent.active ? Theme.accent : touch.has-hover ? Theme.muted : Theme.seam;
            background: Theme.void;
            animate border-color { duration: Theme.quick; }
            Image {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                source: mask.picture;
                image-fit: fill;
                colorize: Theme.accent;
                accessible-role: none;
            }
        }
        if root.renaming != mask.name: Text {
            y: root.picture + 4px;
            width: root.tile;
            height: 14px;
            text: mask.name;
            color: parent.active ? Theme.ink : Theme.muted;
            font-size: 11px;
            overflow: elide;
            horizontal-alignment: center;
            accessible-role: none;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.choose(mask.name);
            }
            double-clicked => {
                Masks.edit(mask.name);
            }
            changed has-hover => {
                Masks.show(self.has-hover ? mask.name : "");
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.menu(mask, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
        if root.renaming == mask.name: FocusScope {
            y: root.picture + 2px;
            height: 18px;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            // escape takes the focus and accepts the text
            key-pressed(event) => {
                if event.text == Key.Escape {
                    field.text = mask.name;
                }
                reject
            }
            field := Field {
                label: "Mask name";
                text: mask.name;
                init => {
                    self.focus();
                    self.select-all();
                }
                accepted(name) => {
                    // a lost focus can accept twice
                    if root.renaming == mask.name {
                        root.renaming = "";
                        Masks.rename(mask.name, name);
                    }
                }
            }
        }
    }
    Rectangle {
        x: mod(Masks.list.length, root.columns) * (root.tile + root.gap);
        y: floor(Masks.list.length / root.columns) * (root.step + root.gap);
        width: root.empty ? root.width : root.tile;
        height: root.picture;
        border-width: 1px;
        border-color: add.has-hover ? Theme.muted : Theme.seam;
        background: add.has-hover ? Theme.raised : transparent;
        accessible-role: button;
        accessible-label: "Add mask";
        function open() {
            root.add(self.absolute-position.x, self.absolute-position.y + self.height);
        }
        accessible-action-default => {
            self.open();
        }
        Focus {
            activate => {
                parent.open();
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Icon {
                    shape: Icons.plus;
                    color: add.has-hover ? Theme.ink : Theme.muted;
                }
            }
            if root.empty: Text {
                text: "Add mask";
                color: add.has-hover ? Theme.ink : Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        add := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.add(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

component Need inherits HorizontalLayout {
    in property <string> text;
    in property <bool> fixable;
    callback install();
    padding-left: 28px;
    padding-right: 12px;
    padding-bottom: 6px;
    spacing: 8px;
    Rectangle {
        width: 2px;
        background: Theme.accent;
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        color: Theme.ink;
        font-size: 11px;
        wrap: word-wrap;
    }
    if root.fixable: Action {
        text: "Install…";
        accent: true;
        clicked => {
            root.install();
        }
    }
}

export component Panel inherits Rectangle {
    in property <[Clip]> clips;
    in property <int> videos;
    in property <int> selected;
    in-out property <Settings> settings;
    in-out property <Sections> sections;
    in-out property <string> scope;
    in property <[string]> configs;
    in-out property <string> config;
    in property <bool> unsaved;
    in property <float> repeats;
    in property <[string]> models;
    in property <string> tensorrt-need;
    in property <bool> tensorrt-fixable;
    in property <[float]> weights;
    in property <string> summary;
    in property <bool> lossless;
    in-out property <Mode> mode;
    in-out property <Munch> munch;
    in property <bool> secret;
    property <bool> copying: root.mode == Mode.copy;
    property <bool> configurable: root.mode == Mode.render;
    property <int> taps;
    callback munched();
    callback secret-tapped(int);
    changed mode => {
        root.taps = 0;
    }
    pure function mode-of(index: int) -> Mode {
        index == 1 ? Mode.copy : index == 2 ? Mode.munch : Mode.render
    }
    in property <string> left;
    in property <string> estimate;
    in property <bool> separate;
    in property <bool> rendering;
    in property <float> progress;
    in property <string> status;
    in property <bool> failed;
    in property <string> rendered;
    in property <string> rendered-name;
    callback reveal(string);
    callback copy-file(string) -> bool;
    property <bool> finished: root.rendered != "" && !root.failed && !root.rendering;
    in property <string> version;
    in property <string> update;
    in property <bool> copied;
    in property <string> done;
    property <bool> naming;
    property <string> name;
    property <bool> confirming;
    property <string> code;
    property <bool> copied-code;
    callback changed();
    pure callback effort-tip(Settings, string, bool) -> string;
    in property <bool> encoders-found;
    callback choose-lut();
    callback choose-config(string);
    callback rescope(string);
    callback save-config();
    callback new-config(string);
    callback delete-config();
    callback render();
    callback cancel();
    callback copy-details();
    callback show-components();
    callback show-update();
    property <bool> gallery: root.configurable && root.sections.masking && root.settings.mask-method == "image";
    changed gallery => {
        if self.gallery {
            Masks.scan();
        }
    }
    Timer {
        interval: 1s;
        running: root.gallery && !Masks.editing;
        triggered => {
            Masks.scan();
        }
    }
    public pure function over-masks(x: length, y: length) -> bool {
        root.gallery && !Masks.editing && x >= masking.absolute-position.x && x < masking.absolute-position.x + masking.width && y >= max(masking.absolute-position.y, scroll.absolute-position.y) && y < min(masking.absolute-position.y + masking.height, scroll.absolute-position.y + scroll.height)
    }
    property <MaskTile> menu-mask;
    property <length> menu-x;
    property <length> menu-y;
    property <bool> deleting;
    property <string> renaming;
    property <bool> menu-shown: mask-menu.is-open || add-menu.is-open;
    changed menu-shown => {
        Popups.open += self.menu-shown ? 1 : -1;
    }
    Timer {
        interval: 3s;
        running: root.deleting;
        triggered => {
            root.deleting = false;
        }
    }
    Timer {
        interval: 3s;
        running: root.confirming;
        triggered => {
            root.confirming = false;
        }
    }
    add-menu := MenuPopup {
        x: root.menu-x;
        y: root.menu-y;
        close-policy: close-on-click-outside;
        MenuItem {
            text: "Draw on the clip";
            enabled: root.videos > 0;
            clicked => {
                Masks.draw();
                add-menu.close();
            }
        }
        MenuItem {
            text: "Import an image…";
            clicked => {
                Masks.add();
                add-menu.close();
            }
        }
    }
    mask-menu := MenuPopup {
        x: root.menu-x;
        y: root.menu-y;
        close-policy: close-on-click-outside;
        MenuItem {
            text: "Edit";
            enabled: root.videos > 0;
            clicked => {
                Masks.edit(root.menu-mask.name);
                mask-menu.close();
            }
        }
        MenuItem {
            text: "Rename";
            clicked => {
                root.renaming = root.menu-mask.name;
                mask-menu.close();
            }
        }
        MenuItem {
            text: "Duplicate";
            clicked => {
                Masks.duplicate(root.menu-mask.name);
                mask-menu.close();
            }
        }
        MenuItem {
            text: "Show in folder";
            clicked => {
                root.reveal(root.menu-mask.path);
                mask-menu.close();
            }
        }
        MenuItem {
            text: root.deleting ? "Delete?" : "Delete";
            accent: root.deleting;
            clicked => {
                if root.deleting {
                    Masks.remove(root.menu-mask.name);
                    mask-menu.close();
                }
                root.deleting = !root.deleting;
            }
        }
    }

    background: Theme.rack;
    VerticalLayout {
        HorizontalLayout {
            height: 54px;
            padding: 10px;
            accessible-role: radio-group;
            accessible-label: "Mode";
            for name[index] in root.secret ? ["Render", "Lossless cut", "Munch"] : ["Render", "Lossless cut"]: Rectangle {
                property <bool> active: root.mode-of(index) == root.mode;
                accessible-role: radio-button;
                accessible-label: name;
                accessible-checkable: true;
                accessible-checked: active;
                accessible-enabled: !root.rendering;
                accessible-item-index: index;
                accessible-item-count: root.secret ? 3 : 2;
                accessible-action-default => {
                    touch.clicked();
                }
                border-width: 1px;
                border-color: active ? Theme.accent : Theme.seam;
                background: active ? Theme.ghost : touch.has-hover ? Theme.raised : transparent;
                animate background, border-color { duration: Theme.quick; }
                Focus {
                    usable: !root.rendering;
                    activate => {
                        touch.clicked();
                    }
                }
                Text {
                    text: name;
                    color: active ? Theme.ink : Theme.muted;
                    font-size: 13px;
                    accessible-role: none;
                }
                touch := TouchArea {
                    mouse-cursor: pointer;
                    enabled: !root.rendering;
                    clicked => {
                        if !active {
                            root.mode = root.mode-of(index);
                        } else if root.copying && !root.secret {
                            root.taps += 1;
                            if root.taps >= 3 {
                                root.secret-tapped(root.taps);
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.seam;
        }

        if root.configurable: HorizontalLayout {
            property <bool> shown: share.is-open;
            changed shown => {
                Popups.open += self.shown ? 1 : -1;
            }
            height: 42px;
            padding: 10px;
            spacing: 10px;
            if !root.naming: Dropdown {
                horizontal-stretch: 1;
                label: "Config";
                options: root.configs;
                value <=> root.config;
                changed(name) => {
                    root.confirming = false;
                    root.choose-config(name);
                }
            }
            if root.naming: Field {
                horizontal-stretch: 1;
                label: "Config name";
                placeholder: "Name";
                text <=> root.name;
                commit: false;
                accepted(name) => {
                    root.naming = false;
                    root.new-config(name);
                }
            }
            Action {
                text: root.done == "Saved" ? "Saved" : root.unsaved ? "Save*" : "Save";
                accessible: "Save config";
                accent: root.unsaved;
                clicked => {
                    if root.naming {
                        root.naming = false;
                        root.new-config(root.name);
                    } else {
                        root.save-config();
                    }
                }
            }
            Action {
                text: root.naming ? "Cancel" : "New";
                accessible: root.naming ? "Cancel new config" : "New config";
                clicked => {
                    root.name = "";
                    root.naming = !root.naming;
                }
            }
            Action {
                text: root.done == "Deleted" ? "Deleted" : root.confirming ? "Delete?" : "Delete";
                accessible: root.confirming ? "Confirm delete config" : "Delete config";
                accent: root.confirming;
                clicked => {
                    if root.confirming {
                        root.delete-config();
                    }
                    root.confirming = !root.confirming;
                }
            }
            Action {
                text: "Share";
                accessible: "Share config";
                active: share.is-open;
                clicked => {
                    root.code = "";
                    root.copied-code = false;
                    Code.share();
                    Code.check("");
                    share.show();
                }
            }
        share := PopupWindow {
            x: 10px;
            y: parent.height - 4px;
            width: root.width - 20px;
            close-policy: close-on-click-outside;
            forward-focus: paste;
            Rectangle {
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.seam;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #00000080;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: "Share code";
                        color: Theme.faint;
                        font-size: 11px;
                    }
                    Scroll {
                        height: min(self.content-height, 6 * 34px - 4px);
                        VerticalLayout {
                            spacing: 4px;
                            for row in Math.ceil(Code.words.length / 3): HorizontalLayout {
                                spacing: 4px;
                                for column in 3: cell := Rectangle {
                                    property <int> at: row * 3 + column;
                                    property <bool> used: self.at < Code.words.length;
                                    horizontal-stretch: 1;
                                    height: 30px;
                                    background: self.used ? Theme.void : transparent;
                                    border-width: 1px;
                                    border-color: self.used ? Theme.seam : transparent;
                                    if cell.used: HorizontalLayout {
                                        padding-left: 8px;
                                        spacing: 6px;
                                        Text {
                                            text: cell.at + 1;
                                            color: Theme.faint;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                            accessible-role: none;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: Code.words[cell.at];
                                            color: Theme.ink;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 26px;
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 1;
                            text: Code.about;
                            color: Theme.faint;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Timer {
                            interval: 1500ms;
                            running: root.copied-code;
                            triggered => {
                                root.copied-code = false;
                            }
                        }
                        Button {
                            text: root.copied-code ? "Copied" : "Copy";
                            main: true;
                            clicked => {
                                Code.copy();
                                root.copied-code = true;
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.seam;
                    }
                    Text {
                        text: "Use a code";
                        color: Theme.faint;
                        font-size: 11px;
                    }
                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        paste := Field {
                            horizontal-stretch: 1;
                            label: "Code to use";
                            placeholder: "Paste the words";
                            text <=> root.code;
                            commit: false;
                            edited => {
                                Code.check(self.text);
                            }
                            accepted(text) => {
                                if Code.valid {
                                    Code.apply(text);
                                    share.close();
                                }
                            }
                        }
                        Button {
                            text: "Apply";
                            main: true;
                            enabled: Code.valid;
                            clicked => {
                                Code.apply(root.code);
                                share.close();
                            }
                        }
                    }
                    if Code.result != "": HorizontalLayout {
                        spacing: 6px;
                        if Code.bad: Rectangle {
                            width: 2px;
                            background: Theme.accent;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: Code.result;
                            color: Code.bad ? Theme.ink : Code.valid ? Theme.ok : Theme.faint;
                            font-size: 11px;
                            wrap: word-wrap;
                            accessible-live-region: polite;
                        }
                    }
                }
            }
        }
        }

        if root.configurable: Rectangle {
            height: 1px;
            background: Theme.seam;
        }

        if root.clips.length > 0 && root.configurable: HorizontalLayout {
            height: 34px;
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 3px;
            padding-bottom: 3px;
            spacing: 10px;
            // a refused rescope keeps the old scope
            property <string> shown: root.selected < 0 ? "all clips" : root.scope;
            changed shown => {
                chooser.value = self.shown;
            }
            Label {
                horizontal-stretch: 1;
                text: "Settings for";
            }
            chooser := Segment {
                label: "Settings scope";
                options: root.selected < 0 ? ["all clips"] : ["all clips", "this clip"];
                value: parent.shown;
                changed(value) => {
                    self.value = parent.shown;
                    root.rescope(value);
                }
            }
        }
        if root.clips.length > 0 && root.configurable: Rectangle {
            height: 1px;
            background: Theme.seam;
        }

        if !root.configurable: VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            padding-top: 10px;
            if root.mode == Mode.munch: VerticalLayout {
                SliderRow {
                    label: "Munch";
                    minimum: 1;
                    maximum: 10;
                    step: 1;
                    value: root.munch.amount;
                    changed(value) => {
                        root.munch.amount = round(value);
                        root.munched();
                    }
                }
                Row {
                    label: "Frame rate";
                    Segment {
                        fill: true;
                        label: "Munch frame rate";
                        options: ["Same", "24", "15", "10", "5"];
                        value: root.munch.fps == 0 ? "Same" : "\{root.munch.fps}";
                        changed(value) => {
                            root.munch.fps = value == "Same" ? 0 : value.to-float();
                            root.munched();
                        }
                    }
                }
                SliderRow {
                    label: "Deep fry";
                    minimum: 0;
                    maximum: 10;
                    step: 1;
                    value: root.munch.fry;
                    changed(value) => {
                        root.munch.fry = round(value);
                        root.munched();
                    }
                }
                SliderRow {
                    label: "Loud";
                    minimum: 0;
                    maximum: 10;
                    step: 1;
                    value: root.munch.loud;
                    changed(value) => {
                        root.munch.loud = round(value);
                        root.munched();
                    }
                }
            }
            if root.estimate != "": Row {
                label: "Size";
                Rectangle { }
                Label {
                    text: root.estimate;
                }
            }
            if root.copying && root.left != "": Note {
                text: "Not kept: " + root.left;
            }
        }

        // the sections stay as they are while hidden
        scroll := Scroll {
            vertical-stretch: root.configurable ? 1 : 0;
            max-height: root.configurable ? 100000px : 0;
            visible: root.configurable;
            Section {
                title: "Dedup";
                open <=> root.sections.dedup;
                // a clip with repeats is the reason to turn this on
                hint: root.repeats >= 0.05 ? "\{round(root.repeats * 100)}% repeats" : "";
                enabled <=> root.settings.dedup;
                toggled => {
                    root.changed();
                }
                SliderRow {
                    label: "Repeats replaced";
                    minimum: 0;
                    maximum: 100;
                    step: 1;
                    unit: "%";
                    value <=> root.settings.dedup-repeats;
                    changed => {
                        root.changed();
                    }
                }
            }

            if root.settings.engine == "svp": Section {
                title: "Pre-interpolation";
                open <=> root.sections.pre;
                enabled <=> root.settings.pre;
                toggled => {
                    root.changed();
                }
                Note {
                    text: "Runs RIFE before SVP. Slower.";
                }
                Row {
                    label: "Frame rate";
                    Rectangle { }
                    Field {
                        label: "Pre-interpolation frame rate";
                        width: 76px;
                        height: 22px;
                        y: 3px;
                        text <=> root.settings.pre-fps;
                        accepted => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Backend";
                    Segment {
                        fill: true;
                        label: "Pre-interpolation backend";
                        options: ["vulkan", "tensorrt"];
                        value <=> root.settings.backend;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.backend == "tensorrt" && root.tensorrt-need != "": Need {
                    text: root.tensorrt-need;
                    fixable: root.tensorrt-fixable;
                    install => {
                        root.show-components();
                    }
                }
                Row {
                    label: "Model";
                    Dropdown {
                        height: 22px;
                        y: 3px;
                        label: "Pre-interpolation model";
                        options: root.models;
                        action: "Get more models…";
                        value <=> root.settings.model;
                        changed => {
                            root.changed();
                        }
                        activated => {
                            root.show-components();
                        }
                    }
                }
            }

            Section {
                title: "Interpolation";
                open <=> root.sections.interpolation;
                enabled <=> root.settings.interpolate;
                toggled => {
                    root.changed();
                }
                Row {
                    label: "Engine";
                    Segment {
                        fill: true;
                        label: "Interpolation engine";
                        options: ["svp", "rife"];
                        value <=> root.settings.engine;
                        changed => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Frame rate";
                    Rectangle { }
                    Field {
                        label: "Interpolation frame rate";
                        width: 76px;
                        height: 22px;
                        y: 3px;
                        text <=> root.settings.interpolation-fps;
                        accepted => {
                            root.changed();
                        }
                    }
                }
                if root.settings.engine == "rife": Row {
                    label: "Backend";
                    Segment {
                        fill: true;
                        label: "Interpolation backend";
                        options: ["vulkan", "tensorrt"];
                        value <=> root.settings.backend;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.engine == "rife" && root.settings.backend == "tensorrt" && root.tensorrt-need != "": Need {
                    text: root.tensorrt-need;
                    fixable: root.tensorrt-fixable;
                    install => {
                        root.show-components();
                    }
                }
                if root.settings.engine == "rife": Row {
                    label: "Model";
                    Dropdown {
                        height: 22px;
                        y: 3px;
                        label: "Interpolation model";
                        options: root.models;
                        action: "Get more models…";
                        value <=> root.settings.model;
                        changed => {
                            root.changed();
                        }
                        activated => {
                            root.show-components();
                        }
                    }
                }
                if root.settings.engine == "svp": Row {
                    label: "Speed";
                    Segment {
                        fill: true;
                        label: "Interpolation speed";
                        options: ["medium", "fast", "faster", "fastest"];
                        value <=> root.settings.speed;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.engine == "svp": Row {
                    label: "Tuning";
                    Dropdown {
                        height: 22px;
                        y: 3px;
                        label: "Interpolation tuning";
                        options: ["weak", "smooth", "film", "animation"];
                        value <=> root.settings.tuning;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.engine == "svp": Row {
                    label: "Look";
                    Segment {
                        fill: true;
                        label: "Interpolation look";
                        options: ["sharp", "standard", "smooth"];
                        value <=> root.settings.algorithm;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.engine == "svp": Row {
                    label: "Half-size analysis";
                    Rectangle { }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            label: "Half-size analysis";
                            checked <=> root.settings.half;
                            toggled => {
                                root.changed();
                            }
                        }
                    }
                }
            }

            masking := Section {
                title: "Masking";
                open <=> root.sections.masking;
                enabled <=> root.settings.mask;
                property <bool> peel: root.settings.mask-method == "peel";
                property <bool> still: root.settings.mask-method == "still";
                property <bool> image: root.settings.mask-method == "image";
                toggled => {
                    root.changed();
                }
                if !Masks.editing: Row {
                    label: "Method";
                    Segment {
                        fill: true;
                        label: "Masking method";
                        options: ["peel", "still", "image"];
                        value <=> root.settings.mask-method;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if masking.peel: Note {
                    text: "Removes the HUD before interpolation and restores it after. Handles transparency.";
                }
                if masking.peel: SliderRow {
                    label: "Limit";
                    minimum: 1;
                    maximum: 20;
                    step: 0.5;
                    value <=> root.settings.mask-peel;
                    changed => {
                        root.changed();
                    }
                }
                property <bool> gallery: masking.image && !Masks.editing;
                changed gallery => {
                    if !self.gallery {
                        Masks.show("");
                    }
                }
                if masking.gallery: Note {
                    text: "Keeps the original frame in the parts that you mark.";
                }
                if masking.gallery && root.settings.mask-image != "" && !Masks.found(Masks.list, root.settings.mask-image): Need {
                    text: "\"\{root.settings.mask-image}\" isn't in the masks folder.";
                }
                if Masks.editing: VerticalLayout {
                    Note {
                        text: "Paint the parts that keep the original frame.";
                    }
                    Row {
                        label: "Name";
                        Field {
                            label: "Mask name";
                            placeholder: "Name";
                            text <=> Masks.name;
                            commit: false;
                        }
                    }
                    if Masks.name != Masks.opened && Masks.found(Masks.list, Masks.name): Need {
                        text: "\"\{Masks.name}\" exists. Save replaces it.";
                    }
                    Row {
                        label: "Tool";
                        Segment {
                            fill: true;
                            label: "Mask tool";
                            options: ["brush", "box", "ellipse"];
                            tips: ["Brush", "Box", "Ellipse"];
                            shortcuts: ["B", "R", "O"];
                            value <=> Masks.tool;
                        }
                    }
                    Row {
                        label: "Mode";
                        Segment {
                            fill: true;
                            label: "Paint mode";
                            options: ["paint", "erase"];
                            tips: ["Paint", "Erase"];
                            shortcuts: ["X", "X"];
                            value <=> Masks.mode;
                        }
                    }
                    if Masks.tool == "brush": SliderRow {
                        label: "Size";
                        minimum: 1;
                        maximum: Masks.brush-max;
                        step: 1;
                        value <=> Masks.size;
                    }
                    Row {
                        label: "";
                        spacing: 14px;
                        Action {
                            text: "Undo";
                            keys: ["Ctrl Z"];
                            enabled: Masks.undoable;
                            clicked => {
                                Masks.undo();
                            }
                        }
                        Action {
                            text: "Redo";
                            keys: ["Ctrl Shift Z"];
                            enabled: Masks.redoable;
                            clicked => {
                                Masks.redo();
                            }
                        }
                        Action {
                            text: "Clear";
                            accessible: "Clear mask";
                            clicked => {
                                Masks.clear();
                            }
                        }
                        Action {
                            text: "Invert";
                            keys: ["Ctrl I"];
                            clicked => {
                                Masks.invert();
                            }
                        }
                        Rectangle { }
                    }
                    if Masks.clip < 0: Need {
                        text: "Move the playhead onto the clip to paint on it.";
                    }
                }
                HorizontalLayout {
                    visible: masking.gallery;
                    height: masking.gallery ? self.preferred-height : 0;
                    padding-left: 28px;
                    padding-right: 12px;
                    padding-top: 4px;
                    padding-bottom: 10px;
                    MaskGrid {
                        chosen: root.settings.mask-image;
                        renaming <=> root.renaming;
                        choose(name) => {
                            root.settings.mask-image = name;
                            root.settings.mask = true;
                            root.changed();
                        }
                        menu(mask, x, y) => {
                            root.menu-mask = mask;
                            root.menu-x = x - root.absolute-position.x;
                            root.menu-y = y - root.absolute-position.y;
                            root.deleting = false;
                            mask-menu.show();
                        }
                        add(x, y) => {
                            root.menu-x = x - root.absolute-position.x;
                            root.menu-y = y - root.absolute-position.y;
                            add-menu.show();
                        }
                    }
                }
                if (masking.image && root.settings.mask-image != "") || Masks.editing: SliderRow {
                    label: "Soft edge";
                    minimum: 0;
                    maximum: 100;
                    step: 1;
                    value <=> root.settings.mask-soft;
                    changed => {
                        root.changed();
                        if self.touched || Masks.editing {
                            Masks.show(root.settings.mask-image);
                        }
                    }
                    changed touched => {
                        if !Masks.editing {
                            Masks.show(self.touched ? root.settings.mask-image : "");
                        }
                    }
                }
                if Masks.editing: HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 12px;
                    padding-top: 6px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    Rectangle { }
                    Button {
                        height: 26px;
                        text: "Cancel";
                        clicked => {
                            Masks.leave();
                        }
                    }
                    Button {
                        height: 26px;
                        text: "Save";
                        main: true;
                        clicked => {
                            Masks.save();
                        }
                    }
                }
                if masking.still: Note {
                    text: "Pixels that don't change are faded instead of warped.";
                }
                if masking.still: SliderRow {
                    label: "Limit";
                    minimum: 0;
                    maximum: 20;
                    step: 0.5;
                    value <=> root.settings.mask-limit;
                    changed => {
                        root.changed();
                    }
                }
                if masking.still: SliderRow {
                    label: "Edge";
                    minimum: 0;
                    maximum: 20;
                    step: 0.5;
                    value <=> root.settings.mask-edge;
                    changed => {
                        root.changed();
                    }
                }
                if masking.still: SliderRow {
                    label: "Tolerance";
                    minimum: 0;
                    maximum: 100;
                    step: 5;
                    unit: "%";
                    value <=> root.settings.mask-tolerance;
                    changed => {
                        root.changed();
                    }
                }
            }

            Section {
                title: "Blending";
                open <=> root.sections.blending;
                enabled <=> root.settings.blend;
                toggled => {
                    root.changed();
                }
                Curve {
                    weights: root.weights;
                    summary: root.summary;
                }
                Row {
                    label: "Frame rate";
                    Rectangle { }
                    Number {
                        label: "Blend frame rate";
                        width: 76px;
                        height: 22px;
                        y: 3px;
                        minimum: 1;
                        maximum: 1000;
                        value <=> root.settings.blend-fps;
                        changed => {
                            root.changed();
                        }
                    }
                }
                SliderRow {
                    label: "Intensity";
                    minimum: 0;
                    maximum: 4;
                    step: 0.1;
                    value <=> root.settings.intensity;
                    changed => {
                        root.changed();
                    }
                }
                SliderRow {
                    label: "Gamma";
                    minimum: 1;
                    maximum: 10;
                    step: 0.1;
                    value <=> root.settings.gamma;
                    changed => {
                        root.changed();
                    }
                }
                Row {
                    label: "Weighting";
                    Dropdown {
                        height: 22px;
                        y: 3px;
                        label: "Blend weighting";
                        options: ["equal", "gaussian", "gaussian_sym", "pyramid", "ascending", "descending", "vegas", "custom"];
                        value <=> root.settings.weighting;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.weighting == "custom": Row {
                    label: "Curve";
                    Field {
                        label: "Custom blend curve";
                        height: 22px;
                        y: 3px;
                        text <=> root.settings.custom;
                        accepted => {
                            root.changed();
                        }
                    }
                }
            }

            Section {
                title: "Color";
                open <=> root.sections.color;
                enabled <=> root.settings.grade;
                toggled => {
                    root.changed();
                }
                SliderRow {
                    label: "Brightness";
                    minimum: 0;
                    maximum: 2;
                    step: 0.05;
                    value <=> root.settings.brightness;
                    changed => {
                        root.changed();
                    }
                }
                SliderRow {
                    label: "Contrast";
                    minimum: 0;
                    maximum: 2;
                    step: 0.05;
                    value <=> root.settings.contrast;
                    changed => {
                        root.changed();
                    }
                }
                SliderRow {
                    label: "Saturation";
                    minimum: 0;
                    maximum: 2;
                    step: 0.05;
                    value <=> root.settings.saturation;
                    changed => {
                        root.changed();
                    }
                }
                SliderRow {
                    label: "Hue";
                    minimum: -180;
                    maximum: 180;
                    step: 5;
                    unit: "°";
                    value <=> root.settings.hue;
                    changed => {
                        root.changed();
                    }
                }
                Row {
                    label: "LUT";
                    Text {
                        horizontal-stretch: 1;
                        text: root.settings.lut == "" ? "None" : root.settings.lut;
                        color: root.settings.lut == "" ? Theme.faint : Theme.ink;
                        overflow: elide;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    Action {
                        text: "Choose…";
                        accessible: "Choose LUT";
                        clicked => {
                            root.choose-lut();
                        }
                    }
                    if root.settings.lut != "": Action {
                        text: "×";
                        accessible: "Clear LUT";
                        clicked => {
                            root.settings.lut = "";
                            root.changed();
                        }
                    }
                }
            }

            Section {
                title: "Upscale";
                open <=> root.sections.upscale;
                enabled <=> root.settings.upscale;
                toggled => {
                    root.changed();
                }
                Note {
                    text: "Mostly used for YouTube, where a higher resolution gets a higher bitrate and looks less compressed.";
                }
                Row {
                    label: "Resolution";
                    Segment {
                        fill: true;
                        label: "Upscale resolution";
                        options: ["1080p", "1440p", "2160p"];
                        value <=> root.settings.resolution;
                        changed => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Method";
                    Dropdown {
                        height: 22px;
                        y: 3px;
                        label: "Upscale method";
                        options: ["nearest", "bilinear", "bicubic", "lanczos"];
                        value <=> root.settings.method;
                        changed => {
                            root.changed();
                        }
                    }
                }
            }

            Section {
                title: "Output";
                open <=> root.sections.output;
                hint: root.estimate;
                toggle: false;
                Row {
                    label: "Codec";
                    Segment {
                        fill: true;
                        label: "Output codec";
                        options: ["h264", "hevc", "av1"];
                        value <=> root.settings.codec;
                        changed => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Encoder";
                    Segment {
                        fill: true;
                        label: "Video encoder";
                        options: ["auto", "hardware", "software"];
                        value <=> root.settings.encoder;
                        changed => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Target";
                    Segment {
                        fill: true;
                        label: "Output target";
                        options: ["quality", "size"];
                        value <=> root.settings.target;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.target == "quality": SliderRow {
                    label: "Quality";
                    maximum: 51;
                    step: 1;
                    value <=> root.settings.quality;
                    changed => {
                        root.changed();
                    }
                }
                if root.settings.target == "size": Row {
                    label: "Size";
                    Rectangle { }
                    Number {
                        label: "Target size in MB";
                        width: 76px;
                        height: 22px;
                        y: 3px;
                        value <=> root.settings.size;
                        changed => {
                            root.changed();
                        }
                    }
                    Label {
                        text: "MB";
                    }
                }
                Row {
                    label: "Effort";
                    Segment {
                        fill: true;
                        label: "Encoding effort";
                        options: ["fastest", "fast", "balanced", "best"];
                        tips: [
                            root.effort-tip(root.settings, "fastest", root.encoders-found),
                            root.effort-tip(root.settings, "fast", root.encoders-found),
                            root.effort-tip(root.settings, "balanced", root.encoders-found),
                            root.effort-tip(root.settings, "best", root.encoders-found),
                        ];
                        value <=> root.settings.effort;
                        changed => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Audio tracks";
                    Segment {
                        fill: true;
                        label: "Audio tracks";
                        options: ["separate", "mix"];
                        value <=> root.settings.audio;
                        changed => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Options";
                    Field {
                        height: 22px;
                        y: 3px;
                        label: "Extra encoder options";
                        placeholder: "e.g. -preset p7";
                        text <=> root.settings.options;
                        accepted => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Container";
                    Segment {
                        fill: true;
                        label: "Output container";
                        options: ["mp4", "mkv", "mov"];
                        value <=> root.settings.container;
                        changed => {
                            root.changed();
                        }
                    }
                }
            }

        }

        Rectangle {
            height: 1px;
            background: Theme.seam;
        }

        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            Rectangle {
                property <bool> ready: root.clips.length > 0;
                height: 36px;
                border-width: 1px;
                border-color: ready ? Theme.accent : Theme.seam;
                background: go.has-hover && ready && !root.rendering ? Theme.ghost : transparent;
                accessible-role: button;
                accessible-label: label.text;
                accessible-enabled: ready;
                accessible-action-default => {
                    go.clicked();
                }
                Focus {
                    usable: ready;
                    activate => {
                        go.clicked();
                    }
                }
                Rectangle {
                    x: 0;
                    width: root.rendering ? root.progress * parent.width : 0;
                    background: Theme.ghost;
                    accessible-role: progress-indicator;
                    accessible-label: "Render progress";
                    accessible-value: round(root.progress * 100);
                    accessible-value-minimum: 0;
                    accessible-value-maximum: 100;
                }
                label := Text {
                    text: root.rendering ? "Stop" : (root.copying || (root.configurable && root.lossless && (root.separate || root.videos < 2)) ? "Export" : "Render") + (root.videos > 1 && (root.separate || root.copying) ? " \{root.videos} clips" : "");
                    color: ready ? Theme.ink : Theme.faint;
                    font-size: 13px;
                    accessible-role: none;
                }
                go := TouchArea {
                    mouse-cursor: pointer;
                    enabled: ready;
                    clicked => {
                        if root.rendering {
                            root.cancel();
                        } else {
                            root.render();
                        }
                    }
                }
            }
            HorizontalLayout {
                height: root.finished ? 24px : 14px;
                spacing: 12px;
                if root.failed: Rectangle {
                    width: 2px;
                    background: Theme.accent;
                }
                if root.finished: Text {
                    horizontal-stretch: 1;
                    min-width: 0;
                    text: root.rendered-name;
                    color: Theme.ink;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                Text {
                    horizontal-stretch: root.finished ? 0 : 1;
                    min-width: 0;
                    text: root.status;
                    color: root.failed ? Theme.ink : Theme.faint;
                    font-size: 11px;
                    vertical-alignment: center;
                    // live numbers do not jitter in monospace
                    font-family: root.rendering ? "monospace" : "";
                    overflow: elide;
                    accessible-role: text;
                    accessible-label: self.text;
                    accessible-live-region: polite;
                }
                if root.finished: FileButtons {
                    copy => {
                        return root.copy-file(root.rendered);
                    }
                    reveal => {
                        root.reveal(root.rendered);
                    }
                }
            }
            HorizontalLayout {
                height: 14px;
                spacing: 12px;
                Rectangle {
                    horizontal-stretch: 1;
                }
                if root.update != "": Action {
                    text: "Update to \{root.update}";
                    accent: true;
                    clicked => {
                        root.show-update();
                    }
                }
                Action {
                    text: root.copied ? "Copied" : root.version;
                    accessible: "Copy version details";
                    clicked => {
                        root.copy-details();
                    }
                }
            }
        }
    }
}
