import { Action, Button, Dropdown, Field, Label, Note, Number, Row, Scroll, Section, Segment, SliderRow, Switch, Theme } from "widgets.slint";
import { Clip, Fact, Sections, Settings } from "types.slint";

component Curve inherits Rectangle {
    in property <[float]> weights;
    in property <string> summary;
    height: root.weights.length > 0 ? 76px : 24px;
    HorizontalLayout {
        x: 28px;
        y: 4px;
        width: parent.width - 40px;
        height: 44px;
        spacing: 1px;
        for weight in root.weights: Rectangle {
            Rectangle {
                y: parent.height - self.height;
                height: max(1px, weight * parent.height);
                background: Theme.accent;
            }
        }
    }
    Text {
        x: 28px;
        y: root.weights.length > 0 ? 54px : 4px;
        text: root.summary;
        color: Theme.faint;
        font-size: 11px;
        font-family: "monospace";
    }
}

export global Code {
    in property <[string]> words;
    in property <string> about;
    in property <string> result;
    in property <bool> valid;
    in property <bool> bad;
    callback share();
    callback copy();
    callback check(string);
    callback apply(string);
}

component Need inherits HorizontalLayout {
    in property <string> text;
    in property <bool> fixable;
    callback install();
    padding-left: 28px;
    padding-right: 12px;
    padding-bottom: 6px;
    spacing: 8px;
    Text {
        horizontal-stretch: 1;
        text: root.text;
        color: Theme.accent;
        font-size: 11px;
        wrap: word-wrap;
    }
    if root.fixable: Action {
        text: "Install…";
        clicked => {
            root.install();
        }
    }
}

export component Panel inherits Rectangle {
    in property <[Clip]> clips;
    in property <int> videos;
    in property <int> selected;
    in-out property <Settings> settings;
    in-out property <Sections> sections;
    in-out property <string> scope;
    in property <[string]> configs;
    in-out property <string> config;
    in property <bool> unsaved;
    in property <float> repeats;
    in property <[string]> models;
    in property <string> tensorrt-need;
    in property <bool> tensorrt-fixable;
    in property <[float]> weights;
    in property <string> summary;
    in property <bool> lossless;
    in-out property <bool> copying;
    in property <[Fact]> left;
    in property <string> estimate;
    in property <bool> separate;
    in property <bool> rendering;
    in property <float> progress;
    in property <string> status;
    in property <bool> failed;
    in property <string> rendered;
    callback reveal(string);
    in property <string> version;
    in property <string> update;
    in property <bool> copied;
    in property <string> done;
    property <bool> naming;
    property <string> name;
    property <bool> confirming;
    property <string> code;
    property <bool> copied-code;
    callback changed();
    pure callback effort-tip(Settings, string, bool) -> string;
    in property <bool> encoders-found;
    callback choose-lut();
    callback choose-config(string);
    callback save-config();
    callback new-config(string);
    callback delete-config();
    callback render();
    callback cancel();
    callback copy-details();
    callback show-components();
    callback show-update();

    background: Theme.rack;
    VerticalLayout {
        HorizontalLayout {
            height: 54px;
            padding: 10px;
            for mode[index] in ["Render", "Lossless cut"]: Rectangle {
                property <bool> active: (index == 1) == root.copying;
                accessible-role: button;
                accessible-label: mode;
                accessible-checkable: true;
                accessible-checked: active;
                accessible-action-default => {
                    touch.clicked();
                }
                border-width: 1px;
                border-color: active ? Theme.accent : Theme.seam;
                background: active ? Theme.ghost : touch.has-hover ? Theme.raised : transparent;
                animate background, border-color { duration: Theme.quick; }
                Text {
                    text: mode;
                    color: active ? Theme.ink : Theme.muted;
                    font-size: 13px;
                }
                touch := TouchArea {
                    mouse-cursor: pointer;
                    enabled: !root.rendering;
                    clicked => {
                        root.copying = index == 1;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.seam;
        }

        if !root.copying: HorizontalLayout {
            height: 42px;
            padding: 10px;
            spacing: 10px;
            if !root.naming: Dropdown {
                horizontal-stretch: 1;
                label: "Config";
                options: root.configs;
                value <=> root.config;
                changed(name) => {
                    root.confirming = false;
                    root.choose-config(name);
                }
            }
            if root.naming: Field {
                horizontal-stretch: 1;
                placeholder: "Name";
                text <=> root.name;
                commit: false;
                accepted(name) => {
                    root.naming = false;
                    root.new-config(name);
                }
            }
            Action {
                text: root.done == "Saved" ? "Saved" : root.unsaved ? "Save*" : "Save";
                active: root.unsaved;
                clicked => {
                    if root.naming {
                        root.naming = false;
                        root.new-config(root.name);
                    } else {
                        root.save-config();
                    }
                }
            }
            Action {
                text: root.naming ? "Cancel" : "New";
                clicked => {
                    root.name = "";
                    root.naming = !root.naming;
                }
            }
            Action {
                text: root.done == "Deleted" ? "Deleted" : root.confirming ? "Delete?" : "Delete";
                active: root.confirming;
                clicked => {
                    if root.confirming {
                        root.delete-config();
                    }
                    root.confirming = !root.confirming;
                }
            }
            Action {
                text: "Share";
                active: share.is-open;
                clicked => {
                    root.code = "";
                    root.copied-code = false;
                    Code.share();
                    Code.check("");
                    share.show();
                }
            }
            share := PopupWindow {
                x: 10px;
                y: parent.height - 4px;
                width: root.width - 20px;
                close-policy: close-on-click-outside;
                Rectangle {
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.seam;
                    drop-shadow-blur: 16px;
                    drop-shadow-offset-y: 4px;
                    drop-shadow-color: #00000080;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Text {
                            text: "Share code";
                            color: Theme.faint;
                            font-size: 11px;
                        }
                        // six rows show, a longer code scrolls
                        Scroll {
                            height: min(self.content-height, 6 * 34px - 4px);
                            VerticalLayout {
                                spacing: 4px;
                                for row in Math.ceil(Code.words.length / 3): HorizontalLayout {
                                    spacing: 4px;
                                    for column in 3: cell := Rectangle {
                                        property <int> at: row * 3 + column;
                                        property <bool> used: self.at < Code.words.length;
                                        horizontal-stretch: 1;
                                        height: 30px;
                                        background: self.used ? Theme.void : transparent;
                                        border-width: 1px;
                                        border-color: self.used ? Theme.seam : transparent;
                                        if cell.used: HorizontalLayout {
                                            padding-left: 8px;
                                            spacing: 6px;
                                            Text {
                                                text: cell.at + 1;
                                                color: Theme.faint;
                                                font-size: 10px;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: Code.words[cell.at];
                                                color: Theme.ink;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 26px;
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: Code.about;
                                color: Theme.faint;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Timer {
                                interval: 1500ms;
                                running: root.copied-code;
                                triggered => {
                                    root.copied-code = false;
                                }
                            }
                            Button {
                                text: root.copied-code ? "Copied" : "Copy";
                                main: true;
                                clicked => {
                                    Code.copy();
                                    root.copied-code = true;
                                }
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.seam;
                        }
                        Text {
                            text: "Use a code";
                            color: Theme.faint;
                            font-size: 11px;
                        }
                        HorizontalLayout {
                            height: 28px;
                            spacing: 8px;
                            Field {
                                horizontal-stretch: 1;
                                placeholder: "Paste the words";
                                text <=> root.code;
                                commit: false;
                                edited => {
                                    Code.check(self.text);
                                }
                                accepted(text) => {
                                    if Code.valid {
                                        Code.apply(text);
                                        share.close();
                                    }
                                }
                            }
                            Button {
                                text: "Apply";
                                main: true;
                                enabled: Code.valid;
                                clicked => {
                                    Code.apply(root.code);
                                    share.close();
                                }
                            }
                        }
                        if Code.result != "": Text {
                            text: Code.result;
                            color: Code.bad ? Theme.accent : Code.valid ? Theme.ok : Theme.faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        if !root.copying: Rectangle {
            height: 1px;
            background: Theme.seam;
        }

        if root.clips.length > 0 && !root.copying: HorizontalLayout {
            height: 34px;
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 3px;
            padding-bottom: 3px;
            spacing: 10px;
            Label {
                horizontal-stretch: 1;
                text: "Settings for";
            }
            Segment {
                options: root.selected < 0 ? ["all clips"] : ["all clips", "this clip"];
                value: root.selected < 0 ? "all clips" : root.scope;
                changed(value) => {
                    root.scope = value;
                    root.changed();
                }
            }
        }
        if root.clips.length > 0 && !root.copying: Rectangle {
            height: 1px;
            background: Theme.seam;
        }

        if root.copying: VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            padding-top: 10px;
            Note {
                text: "No re-encode. Cuts start on keyframes.";
            }
            if root.estimate != "": Row {
                label: "Size";
                Rectangle { }
                Label {
                    text: root.estimate;
                }
            }
            if root.left.length > 0: Rectangle {
                height: 17px;
                Rectangle {
                    height: 1px;
                    background: Theme.seam;
                }
            }
            if root.left.length > 0: HorizontalLayout {
                height: 28px;
                padding-left: 28px;
                Text {
                    text: "Left out";
                    color: Theme.ink;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            for fact in root.left: Row {
                label: fact.name;
                Rectangle { }
                Label {
                    text: fact.value;
                }
            }
        }

        // the sections stay as they are while a copy hides them
        Scroll {
            vertical-stretch: root.copying ? 0 : 1;
            max-height: root.copying ? 0 : 100000px;
            visible: !root.copying;
            Section {
                title: "Dedup";
                open <=> root.sections.dedup;
                // a clip with repeats is the reason to turn this on
                hint: root.repeats >= 0.05 ? "\{round(root.repeats * 100)}% repeats" : "";
                enabled <=> root.settings.dedup;
                toggled => {
                    root.changed();
                }
                SliderRow {
                    label: "Repeats replaced";
                    minimum: 0;
                    maximum: 100;
                    step: 1;
                    unit: "%";
                    value <=> root.settings.dedup-repeats;
                    changed => {
                        root.changed();
                    }
                }
            }

            if root.settings.engine == "svp": Section {
                title: "Pre-interpolation";
                open <=> root.sections.pre;
                enabled <=> root.settings.pre;
                toggled => {
                    root.changed();
                }
                Note {
                    text: "Runs RIFE before SVP. Slower.";
                }
                Row {
                    label: "Frame rate";
                    Rectangle { }
                    Field {
                        label: "Frame rate";
                        width: 76px;
                        height: 22px;
                        y: 3px;
                        text <=> root.settings.pre-fps;
                        accepted => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Backend";
                    Segment {
                        options: ["vulkan", "tensorrt"];
                        value <=> root.settings.backend;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.backend == "tensorrt" && root.tensorrt-need != "": Need {
                    text: root.tensorrt-need;
                    fixable: root.tensorrt-fixable;
                    install => {
                        root.show-components();
                    }
                }
                Row {
                    label: "Model";
                    Dropdown {
                        height: 22px;
                        y: 3px;
                        label: "Model";
                        options: root.models;
                        action: "Get more models…";
                        value <=> root.settings.model;
                        changed => {
                            root.changed();
                        }
                        activated => {
                            root.show-components();
                        }
                    }
                }
            }

            Section {
                title: "Interpolation";
                open <=> root.sections.interpolation;
                enabled <=> root.settings.interpolate;
                toggled => {
                    root.changed();
                }
                Row {
                    label: "Engine";
                    Segment {
                        options: ["svp", "rife"];
                        value <=> root.settings.engine;
                        changed => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Frame rate";
                    Rectangle { }
                    Field {
                        label: "Frame rate";
                        width: 76px;
                        height: 22px;
                        y: 3px;
                        text <=> root.settings.interpolation-fps;
                        accepted => {
                            root.changed();
                        }
                    }
                }
                if root.settings.engine == "rife": Row {
                    label: "Backend";
                    Segment {
                        options: ["vulkan", "tensorrt"];
                        value <=> root.settings.backend;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.engine == "rife" && root.settings.backend == "tensorrt" && root.tensorrt-need != "": Need {
                    text: root.tensorrt-need;
                    fixable: root.tensorrt-fixable;
                    install => {
                        root.show-components();
                    }
                }
                if root.settings.engine == "rife": Row {
                    label: "Model";
                    Dropdown {
                        height: 22px;
                        y: 3px;
                        label: "Model";
                        options: root.models;
                        action: "Get more models…";
                        value <=> root.settings.model;
                        changed => {
                            root.changed();
                        }
                        activated => {
                            root.show-components();
                        }
                    }
                }
                if root.settings.engine == "svp": Row {
                    label: "Speed";
                    Segment {
                        options: ["medium", "fast", "faster", "fastest"];
                        value <=> root.settings.speed;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.engine == "svp": Row {
                    label: "Tuning";
                    Dropdown {
                        height: 22px;
                        y: 3px;
                        label: "Tuning";
                        options: ["weak", "smooth", "film", "animation"];
                        value <=> root.settings.tuning;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.engine == "svp": Row {
                    label: "Look";
                    Segment {
                        options: ["sharp", "standard", "smooth"];
                        value <=> root.settings.algorithm;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.engine == "svp": Row {
                    label: "Half-size analysis";
                    Rectangle { }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                                label: "Half-size analysis";
                            checked <=> root.settings.half;
                            toggled => {
                                root.changed();
                            }
                        }
                    }
                }
            }

            masking := Section {
                title: "Masking";
                open <=> root.sections.masking;
                enabled <=> root.settings.mask;
                property <bool> peel: root.settings.mask-method == "peel";
                toggled => {
                    root.changed();
                }
                Row {
                    label: "Method";
                    Segment {
                        options: ["peel", "still"];
                        value <=> root.settings.mask-method;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if masking.peel: Note {
                    text: "An advanced algorithm that learns the HUD and draws it back after interpolation.";
                }
                if masking.peel: SliderRow {
                    label: "Limit";
                    minimum: 1;
                    maximum: 20;
                    step: 0.5;
                    value <=> root.settings.mask-peel;
                    changed => {
                        root.changed();
                    }
                }
                if !masking.peel: Note {
                    text: "Stops static parts, like the HUD, from smearing.";
                }
                if !masking.peel: SliderRow {
                    label: "Limit";
                    minimum: 0;
                    maximum: 20;
                    step: 0.5;
                    value <=> root.settings.mask-limit;
                    changed => {
                        root.changed();
                    }
                }
                if !masking.peel: SliderRow {
                    label: "Edge";
                    minimum: 0;
                    maximum: 20;
                    step: 0.5;
                    value <=> root.settings.mask-edge;
                    changed => {
                        root.changed();
                    }
                }
                if !masking.peel: SliderRow {
                    label: "Tolerance";
                    minimum: 0;
                    maximum: 100;
                    step: 5;
                    unit: "%";
                    value <=> root.settings.mask-tolerance;
                    changed => {
                        root.changed();
                    }
                }
            }

            Section {
                title: "Blending";
                open <=> root.sections.blending;
                enabled <=> root.settings.blend;
                toggled => {
                    root.changed();
                }
                Curve {
                    weights: root.weights;
                    summary: root.summary;
                }
                Row {
                    label: "Frame rate";
                    Rectangle { }
                    Number {
                        width: 76px;
                        height: 22px;
                        y: 3px;
                        minimum: 1;
                        maximum: 1000;
                        value <=> root.settings.blend-fps;
                        changed => {
                            root.changed();
                        }
                    }
                }
                SliderRow {
                    label: "Intensity";
                    minimum: 0;
                    maximum: 4;
                    step: 0.1;
                    value <=> root.settings.intensity;
                    changed => {
                        root.changed();
                    }
                }
                SliderRow {
                    label: "Gamma";
                    minimum: 1;
                    maximum: 10;
                    step: 0.1;
                    value <=> root.settings.gamma;
                    changed => {
                        root.changed();
                    }
                }
                Row {
                    label: "Weighting";
                    Dropdown {
                        height: 22px;
                        y: 3px;
                        label: "Weighting";
                        options: ["equal", "gaussian", "gaussian_sym", "pyramid", "ascending", "descending", "vegas", "custom"];
                        value <=> root.settings.weighting;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.weighting == "custom": Row {
                    label: "Curve";
                    Field {
                        height: 22px;
                        y: 3px;
                        text <=> root.settings.custom;
                        accepted => {
                            root.changed();
                        }
                    }
                }
            }

            Section {
                title: "Color";
                open <=> root.sections.color;
                enabled <=> root.settings.grade;
                toggled => {
                    root.changed();
                }
                SliderRow {
                    label: "Brightness";
                    minimum: 0;
                    maximum: 2;
                    step: 0.05;
                    value <=> root.settings.brightness;
                    changed => {
                        root.changed();
                    }
                }
                SliderRow {
                    label: "Contrast";
                    minimum: 0;
                    maximum: 2;
                    step: 0.05;
                    value <=> root.settings.contrast;
                    changed => {
                        root.changed();
                    }
                }
                SliderRow {
                    label: "Saturation";
                    minimum: 0;
                    maximum: 2;
                    step: 0.05;
                    value <=> root.settings.saturation;
                    changed => {
                        root.changed();
                    }
                }
                SliderRow {
                    label: "Hue";
                    minimum: -180;
                    maximum: 180;
                    step: 5;
                    unit: "°";
                    value <=> root.settings.hue;
                    changed => {
                        root.changed();
                    }
                }
                Row {
                    label: "LUT";
                    Text {
                        horizontal-stretch: 1;
                        text: root.settings.lut == "" ? "None" : root.settings.lut;
                        color: root.settings.lut == "" ? Theme.faint : Theme.ink;
                        overflow: elide;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    Action {
                        text: "Choose…";
                        clicked => {
                            root.choose-lut();
                        }
                    }
                    if root.settings.lut != "": Action {
                        text: "×";
                        clicked => {
                            root.settings.lut = "";
                            root.changed();
                        }
                    }
                }
            }

            Section {
                title: "Upscale";
                open <=> root.sections.upscale;
                enabled <=> root.settings.upscale;
                toggled => {
                    root.changed();
                }
                Note {
                    text: "Mostly used for YouTube, where a higher resolution gets a higher bitrate and looks less compressed.";
                }
                Row {
                    label: "Resolution";
                    Segment {
                        options: ["1080p", "1440p", "2160p"];
                        value <=> root.settings.resolution;
                        changed => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Method";
                    Dropdown {
                        height: 22px;
                        y: 3px;
                        label: "Method";
                        options: ["nearest", "bilinear", "bicubic", "lanczos"];
                        value <=> root.settings.method;
                        changed => {
                            root.changed();
                        }
                    }
                }
            }

            Section {
                title: "Output";
                open <=> root.sections.output;
                hint: root.estimate;
                toggle: false;
                Row {
                    label: "Codec";
                    Segment {
                        options: ["h264", "hevc", "av1"];
                        value <=> root.settings.codec;
                        changed => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Encoder";
                    Segment {
                        options: ["auto", "hardware", "software"];
                        value <=> root.settings.encoder;
                        changed => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Target";
                    Segment {
                        options: ["quality", "size"];
                        value <=> root.settings.target;
                        changed => {
                            root.changed();
                        }
                    }
                }
                if root.settings.target == "quality": SliderRow {
                    label: "Quality";
                    maximum: 51;
                    step: 1;
                    value <=> root.settings.quality;
                    changed => {
                        root.changed();
                    }
                }
                if root.settings.target == "size": Row {
                    label: "Size";
                    Rectangle { }
                    Number {
                        width: 76px;
                        height: 22px;
                        y: 3px;
                        value <=> root.settings.size;
                        changed => {
                            root.changed();
                        }
                    }
                    Label {
                        text: "MB";
                    }
                }
                Row {
                    label: "Effort";
                    Segment {
                        options: ["fastest", "fast", "balanced", "best"];
                        tips: [
                            root.effort-tip(root.settings, "fastest", root.encoders-found),
                            root.effort-tip(root.settings, "fast", root.encoders-found),
                            root.effort-tip(root.settings, "balanced", root.encoders-found),
                            root.effort-tip(root.settings, "best", root.encoders-found),
                        ];
                        value <=> root.settings.effort;
                        changed => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Audio tracks";
                    Segment {
                        options: ["separate", "mix"];
                        value <=> root.settings.audio;
                        changed => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Options";
                    Field {
                        height: 22px;
                        y: 3px;
                        label: "Options";
                        placeholder: "e.g. -preset p7";
                        text <=> root.settings.options;
                        accepted => {
                            root.changed();
                        }
                    }
                }
                Row {
                    label: "Container";
                    Segment {
                        options: ["mp4", "mkv", "mov"];
                        value <=> root.settings.container;
                        changed => {
                            root.changed();
                        }
                    }
                }
            }

        }

        Rectangle {
            height: 1px;
            background: Theme.seam;
        }

        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            Rectangle {
                property <bool> ready: root.clips.length > 0;
                height: 36px;
                border-width: 1px;
                border-color: ready ? Theme.accent : Theme.seam;
                background: go.has-hover && ready && !root.rendering ? Theme.ghost : transparent;
                Rectangle {
                    x: 0;
                    width: root.rendering ? root.progress * parent.width : 0;
                    background: Theme.ghost;
                }
                Text {
                    text: root.rendering ? "Stop" : (root.copying || (root.lossless && (root.separate || root.videos < 2)) ? "Export" : "Render") + (root.videos > 1 && (root.separate || root.copying) ? " \{root.videos} clips" : "");
                    color: ready ? Theme.ink : Theme.faint;
                    font-size: 13px;
                }
                go := TouchArea {
                    mouse-cursor: pointer;
                    enabled: ready;
                    clicked => {
                        if root.rendering {
                            root.cancel();
                        } else {
                            root.render();
                        }
                    }
                }
            }
            HorizontalLayout {
                height: 14px;
                spacing: 12px;
                Text {
                    horizontal-stretch: 1;
                    min-width: 0;
                    text: root.status;
                    color: root.failed ? Theme.accent : Theme.faint;
                    font-size: 11px;
                    // the live numbers do not jitter in monospace, a finished line matches the action next to it
                    font-family: root.rendering ? "monospace" : "";
                    overflow: elide;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if root.rendered != "" && !root.failed && !root.rendering: Action {
                    text: "Show in folder";
                    clicked => {
                        root.reveal(root.rendered);
                    }
                }
            }
            HorizontalLayout {
                height: 14px;
                spacing: 12px;
                Rectangle {
                    horizontal-stretch: 1;
                }
                if root.update != "": Action {
                    text: "Update to \{root.update}";
                    active: true;
                    clicked => {
                        root.show-update();
                    }
                }
                Action {
                    text: root.copied ? "Copied" : root.version;
                    clicked => {
                        root.copy-details();
                    }
                }
            }
        }
    }
}
