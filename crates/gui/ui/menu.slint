import { Icon, Icons, MenuHeading, MenuItem, MenuPanel, MenuSeparator, MenuTitle, Theme } from "widgets.slint";
import { Family, Clip, Recent } from "types.slint";

export component Menu inherits Rectangle {
    in property <[Clip]> clips;
    in property <bool> rendering;
    in property <[Family]> themes;
    in-out property <string> theme;
    in-out property <bool> light;
    in property <bool> light-available;
    in property <bool> projects;
    in property <[Recent]> recent;
    in property <int> missing;
    in-out property <bool> separate;
    in property <bool> copying;
    callback add-clips();
    callback remove-clip();
    callback close-clips();
    callback mark(string);
    callback undo();
    callback redo();
    callback close-gaps();
    callback render();
    callback cancel();
    callback choose-theme(string);
    callback preview-theme(string);
    callback save-preferences();
    callback show-sheet(string);
    callback new-project();
    callback open-project();
    callback open-recent(string);
    callback clear-recent();
    callback save-project();
    callback save-project-as();
    callback show-project();
    callback locate();
    callback show-preferences();
    callback quit();
    callback save-frame();

    property <bool> sub;
    property <length> sub-y;

    height: 26px;
    background: Theme.rack;
    HorizontalLayout {
        alignment: start;
        padding-left: 4px;
        MenuTitle {
            text: "File";
            clicked => {
                root.sub = false;
                file.show();
            }
            file := PopupWindow {
                x: 0px;
                y: parent.height;
                close-policy: close-on-click-outside;
                width: files.preferred-width + column.preferred-width;
                height: files.preferred-height;
                TouchArea {
                    x: file-panel.width;
                    clicked => {
                        file.close();
                    }
                }
                file-panel := MenuPanel {
                    x: 0px;
                    y: 0px;
                    width: files.preferred-width;
                    height: files.preferred-height;
                    keys := FocusScope {
                        key-pressed(event) => {
                            if event.text == Key.Escape && root.sub {
                                root.sub = false;
                                return accept;
                            }
                            return reject;
                        }
                    }
                    files := VerticalLayout {
                        padding: 4px;
                        if root.projects: MenuItem {
                            text: "New project";
                            hint: "Ctrl N";
                            enabled: !root.rendering;
                            hovered(inside) => {
                                if inside {
                                    root.sub = false;
                                }
                            }
                            clicked => {
                                root.new-project();
                                file.close();
                            }
                        }
                        if root.projects: MenuItem {
                            text: "Open project…";
                            hint: "Ctrl O";
                            enabled: !root.rendering;
                            hovered(inside) => {
                                if inside {
                                    root.sub = false;
                                }
                            }
                            clicked => {
                                root.open-project();
                                file.close();
                            }
                        }
                        if root.projects: MenuItem {
                            text: "Open recent";
                            enabled: root.recent.length > 0 && !root.rendering;
                            clicked => {
                                root.sub-y = self.absolute-position.y - file-panel.absolute-position.y;
                                root.sub = true;
                                keys.focus();
                            }
                            hovered(inside) => {
                                if inside {
                                    root.sub-y = self.absolute-position.y - file-panel.absolute-position.y;
                                    root.sub = true;
                                    keys.focus();
                                }
                            }
                            Icon {
                                x: parent.width - self.width - 8px;
                                y: (parent.height - self.height) / 2;
                                width: 10px;
                                height: 10px;
                                shape: Icons.chevron;
                                color: Theme.faint;
                            }
                        }
                        if root.projects: MenuSeparator { }
                        if root.projects: MenuItem {
                            text: "Save";
                            hint: "Ctrl S";
                            hovered(inside) => {
                                if inside {
                                    root.sub = false;
                                }
                            }
                            clicked => {
                                root.save-project();
                                file.close();
                            }
                        }
                        if root.projects: MenuItem {
                            text: "Save as…";
                            hint: "Ctrl Shift S";
                            hovered(inside) => {
                                if inside {
                                    root.sub = false;
                                }
                            }
                            clicked => {
                                root.save-project-as();
                                file.close();
                            }
                        }
                        if root.projects: MenuSeparator { }
                        MenuItem {
                            text: "Project settings…";
                            hovered(inside) => {
                                if inside {
                                    root.sub = false;
                                }
                            }
                            clicked => {
                                root.show-project();
                                file.close();
                            }
                        }
                        MenuSeparator { }
                        MenuItem {
                            text: "Import…";
                            hovered(inside) => {
                                if inside {
                                    root.sub = false;
                                }
                            }
                            clicked => {
                                root.add-clips();
                                file.close();
                            }
                        }
                        MenuItem {
                            text: "Close all clips";
                            enabled: root.clips.length > 0 && !root.rendering;
                            hovered(inside) => {
                                if inside {
                                    root.sub = false;
                                }
                            }
                            clicked => {
                                root.close-clips();
                                file.close();
                            }
                        }
                        MenuItem {
                            text: "Locate missing files…";
                            enabled: root.missing > 0;
                            hovered(inside) => {
                                if inside {
                                    root.sub = false;
                                }
                            }
                            clicked => {
                                root.locate();
                                file.close();
                            }
                        }
                        MenuItem {
                            text: root.rendering ? "Stop" : "Render";
                            enabled: root.clips.length > 0;
                            hovered(inside) => {
                                if inside {
                                    root.sub = false;
                                }
                            }
                            clicked => {
                                if root.rendering {
                                    root.cancel();
                                } else {
                                    root.render();
                                }
                                file.close();
                            }
                        }
                        MenuItem {
                            text: "Save frame";
                            hint: "Ctrl Shift E";
                            enabled: root.clips.length > 0 && !root.rendering;
                            hovered(inside) => {
                                if inside {
                                    root.sub = false;
                                }
                            }
                            clicked => {
                                root.save-frame();
                                file.close();
                            }
                        }
                        MenuItem {
                            text: "Export each clip separately";
                            checked: root.separate || root.copying;
                            enabled: !root.copying;
                            hovered(inside) => {
                                if inside {
                                    root.sub = false;
                                }
                            }
                            clicked => {
                                root.separate = !root.separate;
                                root.save-preferences();
                                file.close();
                            }
                        }
                        MenuSeparator { }
                        MenuItem {
                            text: "Settings…";
                            hovered(inside) => {
                                if inside {
                                    root.sub = false;
                                }
                            }
                            clicked => {
                                root.show-preferences();
                                file.close();
                            }
                        }
                        MenuItem {
                            text: "Quit";
                            hovered(inside) => {
                                if inside {
                                    root.sub = false;
                                }
                            }
                            clicked => {
                                root.quit();
                                file.close();
                            }
                        }
                    }
                    Rectangle {
                        visible: root.sub;
                        x: file-panel.width;
                        y: root.sub-y;
                        width: column.preferred-width;
                        height: column.preferred-height;
                        MenuPanel {
                            column := VerticalLayout {
                                padding: 4px;
                                for item in root.recent: MenuItem {
                                    min-width: 260px;
                                    text: item.name;
                                    hint: item.folder;
                                    clicked => {
                                        root.open-recent(item.path);
                                        file.close();
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    text: "Clear list";
                                    clicked => {
                                        root.clear-recent();
                                        file.close();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        MenuTitle {
            text: "Edit";
            clicked => {
                edit.show();
            }
            edit := PopupWindow {
                y: parent.height;
                MenuPanel {
                    VerticalLayout {
                        padding: 4px;
                        MenuItem {
                            text: "Undo";
                            hint: "Ctrl Z";
                            clicked => {
                                root.undo();
                            }
                        }
                        MenuItem {
                            text: "Redo";
                            hint: "Ctrl Shift Z";
                            clicked => {
                                root.redo();
                            }
                        }
                        MenuItem {
                            text: "Split";
                            hint: "S";
                            enabled: root.clips.length > 0;
                            clicked => {
                                root.mark("split");
                            }
                        }
                        MenuItem {
                            text: "Close gaps";
                            enabled: root.clips.length > 0;
                            clicked => {
                                root.close-gaps();
                            }
                        }
                        MenuItem {
                            text: "Remove clip";
                            hint: "Delete";
                            enabled: root.clips.length > 0 && !root.rendering;
                            clicked => {
                                root.remove-clip();
                            }
                        }
                    }
                }
            }
        }
        MenuTitle {
            text: "View";
            clicked => {
                view-menu.show();
            }
            view-menu := PopupWindow {
                y: parent.height;
                MenuPanel {
                    VerticalLayout {
                        padding: 4px;
                        MenuHeading {
                            text: "THEME";
                        }
                        MenuItem {
                            text: "Light mode";
                            checked: root.light;
                            enabled: root.light-available;
                            clicked => {
                                root.light = !root.light;
                                root.choose-theme(root.theme);
                            }
                        }
                        Rectangle {
                            height: 9px;
                            Rectangle {
                                height: 1px;
                                background: Theme.seam;
                            }
                        }
                        for family in root.themes: MenuItem {
                            min-width: 260px;
                            text: family.name;
                            checked: family.themes[0] == root.theme || family.themes[1] == root.theme || family.themes[2] == root.theme;
                            clicked => {
                                root.theme = family.themes[0];
                                root.choose-theme(root.theme);
                            }
                            hovered(inside) => {
                                root.preview-theme(inside ? family.themes[0] : root.theme);
                            }
                            // the kinds of one theme are on its line
                            HorizontalLayout {
                                x: parent.width - self.preferred-width - 12px;
                                width: self.preferred-width;
                                spacing: 10px;
                                for name[index] in family.themes: Text {
                                    visible: family.themes.length > 1;
                                    text: family.labels[index];
                                    color: name == root.theme ? Theme.accent : kind.has-hover ? Theme.ink : Theme.faint;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    kind := TouchArea {
                                        clicked => {
                                            root.theme = name;
                                            root.choose-theme(name);
                                        }
                                        changed has-hover => {
                                            root.preview-theme(self.has-hover ? name : root.theme);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        MenuTitle {
            text: "Help";
            clicked => {
                help.show();
            }
            help := PopupWindow {
                y: parent.height;
                MenuPanel {
                    VerticalLayout {
                        padding: 4px;
                        MenuItem {
                            text: "Shortcuts";
                            clicked => {
                                root.show-sheet("Shortcuts");
                            }
                        }
                        MenuItem {
                            text: "Credits";
                            clicked => {
                                root.show-sheet("Credits");
                            }
                        }
                    }
                }
            }
        }
    }
}
