import { Action, Art, Icon, IconButton, Icons, MenuItem, MenuPanel, Piece, Tabs, Theme } from "widgets.slint";
import { Clip, Note } from "types.slint";
import { Frame } from "frame.slint";

struct Tip {
    text: string,
    // a word after the text that opens a page
    link: string,
    url: string,
}

component Pane inherits Rectangle {
    in property <image> source;
    in property <float> scale;
    in property <length> pan-x;
    in property <length> pan-y;
    clip: true;
    Image {
        x: (parent.width - self.width) / 2 + root.pan-x;
        y: (parent.height - self.height) / 2 + root.pan-y;
        width: parent.width * root.scale;
        height: parent.height * root.scale;
        source: root.source;
        image-fit: contain;
        image-rendering: min(self.width, self.height * self.source.width / max(1, self.source.height)) > self.source.width * 1px ? pixelated : smooth;
        accessible-role: image;
        accessible-label: "Preview";
    }
}

component Tag inherits Rectangle {
    in property <string> text;
    width: label.preferred-width + 12px;
    height: 18px;
    background: Theme.rack.with-alpha(0.85);
    label := Text {
        text: root.text;
        color: Theme.muted;
        font-size: 11px;
        font-family: "monospace";
    }
}

export component Stage inherits Rectangle {
    in-out property <[Clip]> clips;
    in property <image> preview;
    in property <image> original;
    in-out property <string> view;
    in property <bool> held;
    in property <float> zoom: 1;
    property <float> scale: root.zoom;
    property <length> pan-x;
    property <length> pan-y;
    in property <[Piece]> art;
    in property <bool> light;
    in property <bool> rendering;
    in property <string> note;
    in property <Note> kind;
    in property <float> progress;
    in property <string> shot;
    in property <string> action;
    callback act();
    callback reveal(string);
    property <bool> closed;
    property <string> last;
    changed note => {
        root.closed = false;
        if root.note != "" {
            root.last = root.note;
        }
    }
    property <[Tip]> tips: [
        { text: "Hold ` to compare with the original" },
        { text: "Right click between two clips for a crossfade" },
        { text: "Alt right click changes only one clip" },
        { text: "Alt drag separates video and audio" },
        { text: "Alt drag an edge to trim one clip and not the next" },
        { text: "Alt wheel changes the height of a track" },
        { text: "Shift drag an edge of the transform box to stretch" },
        { text: "Close gaps in the Edit menu joins the clips" },
        { text: "A config in the folder of a clip is used for that clip" },
        { text: "Drop an image on the timeline to put it over the video" },
        { text: "Export each clip separately is in the File menu" },
        { text: "Gamma in Blending keeps bright things bright in the blur" },
        { text: "\"this clip\" in Settings for changes one clip only" },
        { text: "interpolini-cli renders without the window" },
        { text: "Also try ", link: "Tuck", url: "https://github.com/aechXIII/Tuck" },
    ];
    property <int> tip: -1;
    // a tip shows after a moment, so a short render has none
    property <bool> lit;
    changed rendering => {
        root.lit = false;
    }
    Timer {
        interval: 1.2s;
        running: root.rendering && !root.lit;
        triggered => {
            // the text changes while it does not show, and the first tip of a session comes from the clock
            root.tip = mod(root.tip < 0 ? animation-tick() / 1ms : root.tip + 1, root.tips.length);
            root.lit = true;
        }
    }
    Timer {
        interval: 20s;
        running: root.rendering && root.lit;
        triggered => {
            root.lit = false;
        }
    }
    in property <float> position;
    in property <float> seconds;
    // the box on the picture is on, and the clip that it moves
    in property <bool> transform;
    in property <int> framed;
    in property <bool> copying;
    in-out property <bool> off;
    property <string> shown: root.off ? "off" : root.copying ? "result" : root.held ? "original" : root.view;
    property <length> pane: shown == "side" ? (root.width - 1px) / 2 : root.width;
    property <float> ratio: root.preview.height > 0 ? root.preview.width / root.preview.height : 16 / 9;
    property <length> wide: min(pane, root.height * ratio) * root.scale;
    property <float> divide: 0.5;
    property <float> next;
    out property <length> drawn: wide;
    callback open(string);
    callback place-start();
    callback placed();
    callback add-clips();
    callback viewed();
    callback save-frame();
    callback switched();
    property <length> menu-x;
    property <length> menu-y;
    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        close-policy: close-on-click-outside;
        MenuPanel {
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    text: "Preview";
                    checked: !root.off;
                    clicked => {
                        root.off = !root.off;
                        root.switched();
                        menu.close();
                    }
                }
                MenuItem {
                    text: "Save frame";
                    enabled: !root.off;
                    hint: "Ctrl Shift E";
                    clicked => {
                        root.save-frame();
                        menu.close();
                    }
                }
            }
        }
    }
    changed zoom => {
        root.scale = root.zoom;
        root.pan-x = 0;
        root.pan-y = 0;
        root.viewed();
    }
    // a short light on the picture after a frame is saved
    in-out property <bool> flash;
    background: Theme.void;
    if root.clips.length > 0: Rectangle {
        clip: true;
        property <bool> panning;
        property <length> from-x;
        property <length> from-y;
        property <length> line: root.divide * self.width;
        property <Clip> framed: root.clips[max(0, root.framed)];
        property <float> now: root.position * root.seconds;
        // a button moves the picture, x and y are places in the window
        function pan(event: PointerEvent, x: length, y: length, own: bool) {
            if event.button == PointerEventButton.middle || (own && event.button == PointerEventButton.left) {
                self.panning = event.kind == PointerEventKind.down;
                self.from-x = root.pan-x - x;
                self.from-y = root.pan-y - y;
            } else if event.kind == PointerEventKind.move && self.panning {
                root.pan-x = self.from-x + x;
                root.pan-y = self.from-y + y;
            }
        }
        // the point under the pointer stays under the pointer
        function zoom(x: length, y: length, closer: bool) {
            root.next = clamp(root.scale * (closer ? 1.25 : 0.8), 0.1, 32);
            root.pan-x = x - (x - root.pan-x) * root.next / root.scale;
            root.pan-y = y - (y - root.pan-y) * root.next / root.scale;
            root.scale = root.next;
            root.viewed();
        }
        if root.shown != "off": Pane {
            x: 0;
            width: root.pane;
            source: root.shown == "result" ? root.preview : root.original;
            scale: root.scale;
            pan-x: root.pan-x;
            pan-y: root.pan-y;
        }
        if root.shown == "split": Rectangle {
            x: line;
            width: parent.width - line;
            clip: true;
            Pane {
                x: -line;
                width: root.width;
                source: root.preview;
                scale: root.scale;
                pan-x: root.pan-x;
                pan-y: root.pan-y;
            }
        }
        if root.shown == "side": Rectangle {
            x: root.pane;
            width: 1px;
            background: Theme.seam;
        }
        if root.shown == "side": Pane {
            x: root.pane + 1px;
            width: root.pane;
            source: root.preview;
            scale: root.scale;
            pan-x: root.pan-x;
            pan-y: root.pan-y;
        }
        if (root.held && !root.copying && !root.off) || root.shown == "split" || root.shown == "side": Tag {
            x: 8px;
            y: parent.height - self.height - 8px;
            text: "original";
        }
        if root.shown == "split" || root.shown == "side": Tag {
            x: root.shown == "side" ? root.pane + 9px : parent.width - self.width - 8px;
            y: parent.height - self.height - 8px;
            text: "result";
        }
        if root.off: Text {
            text: "Preview is off";
            color: Theme.faint;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        look := TouchArea {
            scroll-event(event) => {
                parent.zoom(mod(self.mouse-x, root.pane + 1px) - root.pane / 2, self.mouse-y - parent.height / 2, event.delta-y > 0);
                accept
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down && (root.preview.width > 0 || root.off) {
                    root.menu-x = self.absolute-position.x + self.mouse-x - root.absolute-position.x;
                    root.menu-y = self.absolute-position.y + self.mouse-y - root.absolute-position.y;
                    menu.show();
                }
                parent.pan(event, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, true);
            }
            changed has-hover => {
                if !self.has-hover {
                    parent.panning = false;
                }
            }
            double-clicked => {
                root.scale = root.zoom;
                root.pan-x = 0;
                root.pan-y = 0;
                root.viewed();
            }
            // the line and the box are in the touch area, so the wheel over them still zooms the preview
            if root.shown == "split": Rectangle {
                x: line - 5px;
                width: 11px;
                Rectangle {
                    width: 1px;
                    background: Theme.accent;
                }
                Rectangle {
                    width: 5px;
                    height: 21px;
                    background: Theme.ink;
                    border-width: 1px;
                    border-color: Theme.accent;
                }
                TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        if self.pressed {
                            root.divide = clamp((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width, 0, 1);
                        }
                    }
                }
            }
            if root.transform && root.shown != "side" && !root.off && root.framed >= 0 && root.framed < root.clips.length && now >= framed.at - 0.001 && now <= framed.at + framed.kept: Frame {
                x: (parent.width - self.width) / 2 + root.pan-x;
                y: (parent.height - self.height) / 2 + root.pan-y;
                width: wide;
                height: wide / ratio;
                item: framed;
                start => {
                    root.place-start();
                }
                edit(next) => {
                    root.clips[root.framed] = next;
                    root.placed();
                }
                pass(event, x, y) => {
                    pan(event, x, y, false);
                }
            }
        }
        Rectangle {
            background: white;
            opacity: 0;
            states [
                lit when root.flash: {
                    opacity: 0.25;
                    out {
                        animate opacity {
                            duration: 300ms;
                            easing: ease-out;
                        }
                    }
                }
            ]
        }
        Timer {
            interval: 60ms;
            running: root.flash;
            triggered => {
                root.flash = false;
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 8px;
            width: strip.preferred-width;
            height: 32px;
            background: Theme.rack.with-alpha(0.85);
            TouchArea { }
            strip := HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 14px;
                if !root.copying: Tabs {
                    options: ["original", "result", "split", "side"];
                    value <=> root.view;
                    changed => {
                        root.viewed();
                    }
                }
                Action {
                    text: root.scale == 1 && root.pan-x == 0 && root.pan-y == 0 ? "Fit" : "\{round(root.scale * 10) / 10}×";
                    clicked => {
                        root.scale = 1;
                        root.pan-x = 0;
                        root.pan-y = 0;
                        root.viewed();
                    }
                }
            }
        }
    }
    if root.rendering: Rectangle {
        background: Theme.void;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            spacing: 10px;
            HorizontalLayout {
                alignment: center;
                Icon {
                    width: 32px;
                    height: 32px;
                    shape: Icons.hidden;
                    color: Theme.faint;
                }
            }
            Text {
                text: "Preview paused while rendering";
                color: Theme.muted;
                font-size: 13px;
                horizontal-alignment: center;
            }
        }
        // at the foot of the screen, apart from the message
        Rectangle {
            property <Tip> tip: root.tips[root.tip];
            y: parent.height - 44px;
            height: 16px;
            opacity: root.lit ? 1 : 0;
            animate opacity {
                duration: 600ms;
                easing: ease-in-out;
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    text: tip.text;
                    color: Theme.faint.with-alpha(0.6);
                    font-size: 11px;
                    vertical-alignment: center;
                }
                if tip.link != "": Rectangle {
                    width: word.preferred-width;
                    word := Text {
                        height: 100%;
                        text: tip.link;
                        color: link.has-hover ? Theme.ink : Theme.faint;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: word.color.with-alpha(0.5);
                    }
                    link := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open(tip.url);
                        }
                    }
                }
            }
        }
    }
    card := Rectangle {
        property <bool> shown: root.note != "" && !root.closed;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 16px + (self.shown ? 0px : 6px);
        width: min(root.width * 0.6, pill.preferred-width);
        height: pill.preferred-height;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.seam;
        border-radius: 8px;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: black.with-alpha(0.4);
        opacity: self.shown ? 1 : 0;
        visible: self.shown || self.opacity > 0;
        animate opacity, y {
            duration: 200ms;
            easing: ease-out;
        }
        if root.progress >= 0: Rectangle {
            x: 10px;
            y: parent.height - 4px;
            width: parent.width - 20px;
            height: 2px;
            border-radius: 1px;
            background: Theme.seam;
            Rectangle {
                x: 0;
                width: parent.width * clamp(root.progress, 0, 1);
                border-radius: 1px;
                background: Theme.accent;
            }
        }
        pill := HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 14px;
            padding-right: root.kind == Note.warning || root.kind == Note.notice ? 8px : 14px;
            spacing: 12px;
            if root.kind == Note.warning || root.kind == Note.notice: Rectangle {
                width: 16px;
                Icon {
                    x: 0;
                    y: 0;
                    shape: Icons.warning;
                    color: Theme.accent;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.last;
                color: Theme.ink;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
                max-height: 36px;
                vertical-alignment: center;
            }
            if root.kind == Note.brief && root.shot != "": Action {
                text: "Show in folder";
                size: 12px;
                clicked => {
                    root.reveal(root.shot);
                }
            }
            if root.kind == Note.notice && root.action != "": Action {
                text: root.action;
                size: 12px;
                clicked => {
                    root.act();
                }
            }
            if root.kind == Note.warning || root.kind == Note.notice: IconButton {
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                shape: Icons.clear;
                label: "Close";
                clicked => {
                    root.closed = true;
                }
            }
        }
        Timer {
            interval: 3s;
            running: root.kind == Note.brief && parent.shown;
            triggered => {
                root.closed = true;
            }
        }
    }
    if root.clips.length == 0: Art {
        pieces: root.art;
        area: "start";
        light: root.light;
    }
    if root.clips.length == 0: VerticalLayout {
        alignment: center;
        spacing: 14px;
        Text {
            text: "Drop clips here";
            color: Theme.muted;
            font-size: 16px;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 108px;
                height: 30px;
                border-width: 1px;
                border-color: Theme.accent;
                background: browse.has-hover ? Theme.ghost : transparent;
                Text {
                    text: "Add clips";
                    color: Theme.ink;
                }
                browse := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.add-clips();
                    }
                }
            }
        }
    }
}
