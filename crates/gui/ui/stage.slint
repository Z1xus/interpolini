import { Action, Art, Button, FileButtons, Focus, Icon, IconButton, Icons, MenuItem, MenuPopup, Piece, Popups, Tabs, Theme } from "widgets.slint";
import { Clip, Masks, Note } from "types.slint";
import { Frame } from "frame.slint";

struct Tip {
    text: string,
    // a word after the text that opens a page
    link: string,
    url: string,
}

component Pane inherits Rectangle {
    in property <image> source;
    in property <string> name;
    in property <float> scale;
    in property <length> pan-x;
    in property <length> pan-y;
    clip: true;
    Image {
        x: (parent.width - self.width) / 2 + root.pan-x;
        y: (parent.height - self.height) / 2 + root.pan-y;
        width: parent.width * root.scale;
        height: parent.height * root.scale;
        source: root.source;
        image-fit: contain;
        image-rendering: min(self.width, self.height * self.source.width / max(1, self.source.height)) > self.source.width * 1px ? pixelated : smooth;
        accessible-role: image;
        accessible-label: "Preview, " + root.name;
    }
}

component Tint inherits Rectangle {
    in property <Clip> item;
    in property <length> box-x;
    in property <length> box-y;
    in property <length> box-width;
    in property <length> box-height;
    in property <image> picture;
    property <length> left: max(0, root.box-x + root.item.crop-left * root.box-width);
    property <length> top: max(0, root.box-y + root.item.crop-top * root.box-height);
    property <length> right: min(root.width, root.box-x + (1 - root.item.crop-right) * root.box-width);
    property <length> bottom: min(root.height, root.box-y + (1 - root.item.crop-bottom) * root.box-height);
    Rectangle {
        x: root.left;
        y: root.top;
        width: max(0, root.right - root.left);
        height: max(0, root.bottom - root.top);
        clip: true;
        opacity: 0.5;
        tiles := Rectangle {
            x: root.box-x - root.left;
            y: root.box-y - root.top;
            width: root.box-width;
            height: root.box-height;
            // whole pixels, else seams show between tiles
            pure function edge-x(column: int) -> length {
                round((self.absolute-position.x + column * self.width / Masks.width) / 1phx) * 1phx - self.absolute-position.x
            }
            pure function edge-y(row: int) -> length {
                round((self.absolute-position.y + row * self.height / Masks.height) / 1phx) * 1phx - self.absolute-position.y
            }
            if root.picture.width > 0: Image {
                width: tiles.width;
                height: tiles.height;
                source: root.picture;
                image-fit: fill;
                colorize: Theme.accent;
                accessible-role: none;
            }
            for tile in Masks.tiles: Image {
                x: tiles.edge-x(tile.x);
                y: tiles.edge-y(tile.y);
                width: tiles.edge-x(tile.x + tile.width) - self.x;
                height: tiles.edge-y(tile.y + tile.height) - self.y;
                source: tile.picture;
                image-fit: fill;
                image-rendering: pixelated;
                colorize: Theme.accent;
                accessible-role: none;
            }
        }
    }
}

component Tag inherits Rectangle {
    in property <string> text;
    width: label.preferred-width + 12px;
    height: 18px;
    background: Theme.rack.with-alpha(0.85);
    label := Text {
        text: root.text;
        color: Theme.muted;
        font-size: 11px;
        font-family: "monospace";
    }
}

export component Stage inherits Rectangle {
    in-out property <[Clip]> clips;
    in property <image> preview;
    in property <image> original;
    in-out property <string> view;
    in property <bool> held;
    in property <float> zoom: 1;
    property <float> scale: root.zoom;
    property <length> pan-x;
    property <length> pan-y;
    in property <[Piece]> art;
    in property <bool> light;
    in property <bool> rendering;
    in property <string> note;
    in property <Note> kind;
    in property <float> progress;
    in property <string> shot;
    in property <string> action;
    callback act();
    callback reveal(string);
    callback copy-file(string) -> bool;
    property <bool> closed;
    property <string> last;
    changed note => {
        root.closed = false;
        if root.note != "" {
            root.last = root.note;
        }
    }
    property <[Tip]> tips: [
        { text: "Hold ` to compare with the original" },
        { text: "Right click between two clips for a crossfade" },
        { text: "Alt right click changes only one clip" },
        { text: "Alt drag separates video and audio" },
        { text: "Alt drag an edge to trim one clip and not the next" },
        { text: "Alt wheel changes the height of a track" },
        { text: "Ctrl drag lets a clip overlap and cut another clip" },
        { text: "Shift drag flips snapping for that one drag" },
        { text: "N turns snapping on or off" },
        { text: "Drag a top corner of a clip to fade it" },
        { text: "Right click near the edge of a clip for its fade" },
        { text: "Right click a clip to change its speed" },
        { text: "Double click a slider in a menu to reset it" },
        { text: "Slow a clip down with interpolation on for real slow motion" },
        { text: "Shift click selects everything between two clips" },
        { text: "Drag on empty space to select clips" },
        { text: "Right click a gap to ripple delete it" },
        { text: "Shift Delete removes a clip and closes its gap" },
        { text: "\\ fits the whole timeline in view" },
        { text: "Shift drag an edge of the transform box to stretch" },
        { text: "Close gaps in the Edit menu joins the clips" },
        { text: "A config in the folder of a clip is used for that clip" },
        { text: "Drop an image on the timeline to put it over the video" },
        { text: "Export each clip separately is in the File menu" },
        { text: "Gamma in Blending keeps bright things bright in the blur" },
        { text: "\"this clip\" in Settings for changes one clip only" },
        { text: "interpolini-cli renders without the window" },
        { text: "Right click a track name for its options" },
        { text: "Tab moves between all controls" },
        { text: "F10 opens the menus" },
        { text: "Also try ", link: "Tuck", url: "https://github.com/aechXIII/Tuck" },
    ];
    property <int> tip: -1;
    // a tip shows after a moment, so a short render has none
    property <bool> lit;
    changed rendering => {
        root.lit = false;
    }
    Timer {
        interval: 1.2s;
        running: root.rendering && !root.lit;
        triggered => {
            // the text changes while it does not show, and the first tip of a session comes from the clock
            root.tip = mod(root.tip < 0 ? animation-tick() / 1ms : root.tip + 1, root.tips.length);
            root.lit = true;
        }
    }
    Timer {
        interval: 20s;
        running: root.rendering && root.lit;
        triggered => {
            root.lit = false;
        }
    }
    in property <float> position;
    in property <float> seconds;
    // the box on the picture is on, and the clip that it moves
    in property <bool> transform;
    in property <int> framed;
    in property <bool> copying;
    in-out property <bool> off;
    property <string> shown: root.off ? "off" : root.copying ? "result" : root.held ? "original" : root.view;
    property <length> pane: shown == "side" ? (root.width - 1px) / 2 : root.width;
    property <float> ratio: root.preview.height > 0 ? root.preview.width / root.preview.height : 16 / 9;
    property <length> strip: root.clips.length > 0 ? 30px : 0px;
    property <length> wide: min(pane, (root.height - root.strip) * ratio) * root.scale;
    property <bool> masked: Masks.clip >= 0 && Masks.clip < root.clips.length && !root.copying && !root.off;
    // the paint area can go away in the middle of a stroke
    changed masked => {
        if !self.masked {
            Masks.done();
        }
    }
    property <Clip> target: root.clips[max(0, Masks.clip)];
    property <length> box-width: (root.target.ratio > root.ratio ? 1 : root.target.ratio / root.ratio) * root.target.zoom-x * root.wide;
    property <length> box-height: (root.target.ratio > root.ratio ? root.ratio / root.target.ratio : 1) * root.target.zoom-y * root.wide / root.ratio;
    property <length> box-x: (root.pane - root.wide) / 2 + root.pan-x + (0.5 + root.target.x) * root.wide - root.box-width / 2;
    property <length> box-y: (root.height - root.strip - root.wide / root.ratio) / 2 + root.pan-y + (0.5 + root.target.y) * root.wide / root.ratio - root.box-height / 2;
    property <float> divide: 0.5;
    property <float> next;
    out property <length> drawn: wide;
    callback open(string);
    callback place-start();
    callback placed();
    callback add-clips();
    callback viewed();
    callback save-frame();
    callback switched();
    property <length> menu-x;
    property <length> menu-y;
    property <bool> menu-shown: menu.is-open;
    changed menu-shown => {
        Popups.open += root.menu-shown ? 1 : -1;
    }
    menu := MenuPopup {
        x: root.menu-x;
        y: root.menu-y;
        close-policy: close-on-click-outside;
        MenuItem {
            text: "Preview";
            toggle: true;
            checked: !root.off;
            clicked => {
                root.off = !root.off;
                root.switched();
                menu.close();
            }
        }
        MenuItem {
            text: "Save frame";
            enabled: !root.off;
            hint: "Ctrl Shift E";
            clicked => {
                root.save-frame();
                menu.close();
            }
        }
    }
    changed zoom => {
        root.scale = root.zoom;
        root.pan-x = 0;
        root.pan-y = 0;
        root.viewed();
    }
    // a short light on the picture after a frame is saved
    in-out property <bool> flash;
    background: Theme.void;
    if root.clips.length > 0: Rectangle {
        y: root.strip;
        height: root.height - root.strip;
        clip: true;
        property <bool> panning;
        property <length> from-x;
        property <length> from-y;
        property <length> line: root.divide * self.width;
        property <Clip> framed: root.clips[max(0, root.framed)];
        property <float> now: root.position * root.seconds;
        // a button moves the picture, x and y are places in the window
        function pan(event: PointerEvent, x: length, y: length, own: bool) {
            if event.button == PointerEventButton.middle || (own && event.button == PointerEventButton.left) {
                self.panning = event.kind == PointerEventKind.down;
                self.from-x = root.pan-x - x;
                self.from-y = root.pan-y - y;
            } else if event.kind == PointerEventKind.move && self.panning {
                root.pan-x = self.from-x + x;
                root.pan-y = self.from-y + y;
            }
        }
        // the point under the pointer stays under the pointer
        function zoom(x: length, y: length, closer: bool) {
            root.next = clamp(root.scale * (closer ? 1.25 : 0.8), 0.1, 32);
            root.pan-x = x - (x - root.pan-x) * root.next / root.scale;
            root.pan-y = y - (y - root.pan-y) * root.next / root.scale;
            root.scale = root.next;
            root.viewed();
        }
        if root.shown != "off": Pane {
            x: 0;
            width: root.pane;
            name: root.shown == "result" ? "result" : "original";
            source: root.shown == "result" ? root.preview : root.original;
            scale: root.scale;
            pan-x: root.pan-x;
            pan-y: root.pan-y;
        }
        if root.shown == "split": Rectangle {
            x: line;
            width: parent.width - line;
            clip: true;
            Pane {
                x: -line;
                width: root.width;
                name: "result";
                source: root.preview;
                scale: root.scale;
                pan-x: root.pan-x;
                pan-y: root.pan-y;
            }
        }
        if root.shown == "side": Rectangle {
            x: root.pane;
            width: 1px;
            background: Theme.seam;
        }
        if root.shown == "side": Pane {
            x: root.pane + 1px;
            width: root.pane;
            name: "result";
            source: root.preview;
            scale: root.scale;
            pan-x: root.pan-x;
            pan-y: root.pan-y;
        }
        for side in root.shown == "side" ? 2 : 1: Tint {
            x: side * (root.pane + 1px);
            width: root.pane;
            visible: root.masked && (Masks.editing || Masks.hover.width > 0);
            item: root.target;
            box-x: root.box-x;
            box-y: root.box-y;
            box-width: root.box-width;
            box-height: root.box-height;
            picture: Masks.hover;
        }
        if (root.held && !root.copying && !root.off) || root.shown == "split" || root.shown == "side": Tag {
            x: 8px;
            y: parent.height - self.height - 8px;
            text: "original";
        }
        if root.shown == "split" || root.shown == "side": Tag {
            x: root.shown == "side" ? root.pane + 9px : parent.width - self.width - 8px;
            y: parent.height - self.height - 8px;
            text: "result";
        }
        if root.off: Text {
            text: "Preview is off";
            color: Theme.faint;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        look := TouchArea {
            scroll-event(event) => {
                parent.zoom(mod(self.mouse-x, root.pane + 1px) - root.pane / 2, self.mouse-y - parent.height / 2, event.delta-y > 0);
                accept
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down && (root.preview.width > 0 || root.off) {
                    root.menu-x = self.absolute-position.x + self.mouse-x - root.absolute-position.x;
                    root.menu-y = self.absolute-position.y + self.mouse-y - root.absolute-position.y;
                    menu.show();
                }
                parent.pan(event, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, true);
            }
            changed has-hover => {
                if !self.has-hover {
                    parent.panning = false;
                }
            }
            double-clicked => {
                root.scale = root.zoom;
                root.pan-x = 0;
                root.pan-y = 0;
                root.viewed();
            }
            if root.masked && Masks.editing: paint := TouchArea {
                mouse-cursor: crosshair;
                property <bool> down;
                property <PointerEventButton> button;
                property <bool> erasing;
                property <length> side;
                property <float> start-x;
                property <float> start-y;
                property <length> from-x: self.side + root.box-x + self.start-x * root.box-width / Masks.width;
                property <length> from-y: root.box-y + self.start-y * root.box-height / Masks.height;
                property <bool> shift;
                property <length> reach: max(abs(self.mouse-x - self.from-x), abs(self.mouse-y - self.from-y));
                property <length> to-x: !self.shift ? self.mouse-x : self.from-x + (self.mouse-x < self.from-x ? -self.reach : self.reach);
                property <length> to-y: !self.shift ? self.mouse-y : self.from-y + (self.mouse-y < self.from-y ? -self.reach : self.reach);
                property <bool> drawn;
                property <float> last-x;
                property <float> last-y;
                property <string> began;
                property <string> tool: self.down ? self.began : Masks.tool;
                property <bool> brush: self.tool == "brush";
                pure function mask-x(x: length) -> float {
                    (x - self.side - root.box-x) / root.box-width * Masks.width
                }
                pure function mask-y(y: length) -> float {
                    (y - root.box-y) / root.box-height * Masks.height
                }
                // the wheel comes here while a button is down
                scroll-event(event) => {
                    zoom(mod(self.mouse-x, root.pane + 1px) - root.pane / 2, self.mouse-y - self.height / 2, event.delta-y > 0);
                    accept
                }
                function dab(first: bool) {
                    self.last-x = mask-x(self.mouse-x);
                    self.last-y = mask-y(self.mouse-y);
                    self.drawn = true;
                    Masks.stroke(self.last-x, self.last-y, self.erasing, first);
                }
                pointer-event(event) => {
                    self.shift = event.modifiers.shift;
                    if event.button == PointerEventButton.middle || (event.kind == PointerEventKind.move && !self.down) {
                        pan(event, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false);
                    } else if event.kind == PointerEventKind.down && !self.down && (event.button == PointerEventButton.left || event.button == PointerEventButton.right) {
                        self.began = Masks.tool;
                        self.down = true;
                        self.button = event.button;
                        self.erasing = ((event.button == PointerEventButton.right) != (Masks.mode == "erase")) != event.modifiers.alt;
                        self.side = root.shown == "side" && self.mouse-x > root.pane ? root.pane + 1px : 0;
                        self.start-x = mask-x(self.mouse-x);
                        self.start-y = mask-y(self.mouse-y);
                        if self.brush && self.shift && self.drawn {
                            Masks.stroke(self.last-x, self.last-y, self.erasing, true);
                            self.dab(false);
                        } else if self.brush {
                            self.dab(true);
                        }
                    } else if event.kind == PointerEventKind.move && self.down && self.brush {
                        self.dab(false);
                    } else if self.down && (event.kind == PointerEventKind.cancel || (event.kind == PointerEventKind.up && event.button == self.button)) {
                        self.finish();
                    }
                }
                function finish() {
                    if !self.brush {
                        Masks.shape(self.start-x, self.start-y, mask-x(self.to-x), mask-y(self.to-y), self.erasing, self.tool == "ellipse");
                    }
                    self.down = false;
                    Masks.done();
                }
                // the release of another button ends the grab
                changed has-hover => {
                    if !self.has-hover && self.down {
                        self.finish();
                    }
                }
                if self.down && !self.brush: Rectangle {
                    x: min(paint.from-x, paint.to-x);
                    y: min(paint.from-y, paint.to-y);
                    width: abs(paint.to-x - paint.from-x);
                    height: abs(paint.to-y - paint.from-y);
                    if paint.tool == "box": Rectangle {
                        background: paint.erasing ? Theme.void.with-alpha(0.5) : Theme.accent.with-alpha(0.5);
                        border-width: 1px;
                        border-color: Theme.ink;
                    }
                    if paint.tool == "ellipse" && paint.mouse-x != paint.from-x && paint.mouse-y != paint.from-y: Path {
                        // a path keeps the ratio of its viewbox
                        property <float> wide: self.width / 1px;
                        property <float> high: self.height / 1px;
                        viewbox-width: self.wide;
                        viewbox-height: self.high;
                        commands: "M0 \{self.high / 2}A\{self.wide / 2} \{self.high / 2} 0 0 0 \{self.wide} \{self.high / 2}A\{self.wide / 2} \{self.high / 2} 0 0 0 0 \{self.high / 2}Z";
                        fill: paint.erasing ? Theme.void.with-alpha(0.5) : Theme.accent.with-alpha(0.5);
                        stroke: Theme.ink;
                        stroke-width: 1px;
                    }
                }
                if self.brush && self.has-hover: Rectangle {
                    x: paint.mouse-x - self.width / 2;
                    y: paint.mouse-y - self.height / 2;
                    width: max(4px, Masks.size * root.box-width / Masks.width);
                    height: max(4px, Masks.size * root.box-height / Masks.height);
                    border-radius: min(self.width, self.height) / 2;
                    border-width: 1px;
                    border-color: Theme.ink;
                    Rectangle {
                        border-radius: min(self.width, self.height) / 2;
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        border-width: 1px;
                        border-color: Theme.void;
                    }
                }
            }
            // inside the touch area the wheel still zooms
            if root.shown == "split": Rectangle {
                x: line - 5px;
                width: 11px;
                Rectangle {
                    width: 1px;
                    background: Theme.accent;
                }
                Rectangle {
                    width: 5px;
                    height: 21px;
                    background: Theme.ink;
                    border-width: 1px;
                    border-color: Theme.accent;
                }
                TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        if self.pressed {
                            root.divide = clamp((self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width, 0, 1);
                        }
                    }
                }
            }
            if root.transform && !Masks.editing && root.shown != "side" && !root.off && root.framed >= 0 && root.framed < root.clips.length && now >= framed.at - 0.001 && now <= framed.at + framed.kept: Frame {
                x: (parent.width - self.width) / 2 + root.pan-x;
                y: (parent.height - self.height) / 2 + root.pan-y;
                width: wide;
                height: wide / ratio;
                item: framed;
                start => {
                    root.place-start();
                }
                edit(next) => {
                    root.clips[root.framed] = next;
                    root.placed();
                }
                pass(event, x, y) => {
                    pan(event, x, y, false);
                }
            }
        }
        Rectangle {
            background: white;
            opacity: 0;
            states [
                lit when root.flash: {
                    opacity: 0.25;
                    out {
                        animate opacity {
                            duration: 300ms;
                            easing: ease-out;
                        }
                    }
                }
            ]
        }
        Timer {
            interval: 60ms;
            running: root.flash;
            triggered => {
                root.flash = false;
            }
        }
    }
    if root.clips.length > 0: Rectangle {
        height: root.strip;
        y: 0;
        background: Theme.rack;
        TouchArea { }
        if !root.copying: Tabs {
            x: (parent.width - self.width) / 2;
            width: self.preferred-width;
            label: "Preview view";
            options: ["original", "result", "split", "side"];
            value <=> root.view;
            changed => {
                root.viewed();
            }
        }
        Action {
            property <bool> fit: root.scale == 1 && root.pan-x == 0 && root.pan-y == 0;
            x: parent.width - self.width - 12px;
            width: self.preferred-width;
            text: self.fit ? "Fit" : "\{round(root.scale * 10) / 10}×";
            accessible: self.fit ? "Zoom, fit" : "Zoom \{round(root.scale * 10) / 10} times";
            clicked => {
                root.scale = 1;
                root.pan-x = 0;
                root.pan-y = 0;
                root.viewed();
            }
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.seam;
        }
    }
    if root.rendering: Rectangle {
        background: Theme.void;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            spacing: 10px;
            HorizontalLayout {
                alignment: center;
                Icon {
                    width: 32px;
                    height: 32px;
                    shape: Icons.hidden;
                    color: Theme.faint;
                }
            }
            Text {
                text: "Preview paused while rendering";
                color: Theme.muted;
                font-size: 13px;
                horizontal-alignment: center;
                accessible-role: text;
            }
        }
        // at the foot of the screen, apart from the message
        Rectangle {
            property <Tip> tip: root.tips[root.tip];
            y: parent.height - 44px;
            height: 16px;
            opacity: root.lit ? 1 : 0;
            animate opacity {
                duration: 600ms;
                easing: ease-in-out;
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    text: tip.text;
                    color: Theme.faint.with-alpha(0.6);
                    font-size: 11px;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                if tip.link != "": Rectangle {
                    width: word.preferred-width;
                    accessible-role: button;
                    accessible-label: "Open " + tip.link;
                    accessible-action-default => {
                        root.open(tip.url);
                    }
                    Focus {
                        usable: root.lit;
                        activate => {
                            root.open(tip.url);
                        }
                    }
                    word := Text {
                        height: 100%;
                        text: tip.link;
                        color: link.has-hover ? Theme.ink : Theme.faint;
                        font-size: 11px;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: word.color.with-alpha(0.5);
                    }
                    link := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open(tip.url);
                        }
                    }
                }
            }
        }
    }
    card := Rectangle {
        property <bool> shown: root.note != "" && !root.closed;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 16px + (self.shown ? 0px : 6px);
        width: min(root.width * 0.6, pill.preferred-width);
        height: pill.preferred-height;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.seam;
        border-radius: 8px;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: black.with-alpha(0.4);
        opacity: self.shown ? 1 : 0;
        visible: self.shown || self.opacity > 0;
        animate opacity, y {
            duration: 200ms;
            easing: ease-out;
        }
        if root.progress >= 0 && card.shown: Rectangle {
            accessible-role: progress-indicator;
            accessible-label: "Progress";
            accessible-value: round(clamp(root.progress, 0, 1) * 100) + "";
            accessible-value-minimum: 0;
            accessible-value-maximum: 100;
            x: 10px;
            y: parent.height - 4px;
            width: parent.width - 20px;
            height: 2px;
            border-radius: 1px;
            background: Theme.seam;
            Rectangle {
                x: 0;
                width: parent.width * clamp(root.progress, 0, 1);
                border-radius: 1px;
                background: Theme.accent;
            }
        }
        pill := HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 14px;
            padding-right: root.kind == Note.warning || root.kind == Note.notice ? 8px : 14px;
            spacing: 12px;
            if root.kind == Note.warning || root.kind == Note.notice: Rectangle {
                width: 16px;
                Icon {
                    x: 0;
                    y: 0;
                    shape: Icons.warning;
                    color: Theme.accent;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.last;
                color: Theme.ink;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
                max-height: 36px;
                vertical-alignment: center;
                accessible-role: text;
                accessible-live-region: root.kind == Note.warning ? assertive : polite;
            }
            if root.kind == Note.brief && root.shot != "": FileButtons {
                copy => {
                    return root.copy-file(root.shot);
                }
                reveal => {
                    root.reveal(root.shot);
                }
            }
            if root.kind == Note.notice && root.action != "": Action {
                text: root.action;
                accent: true;
                size: 12px;
                clicked => {
                    root.act();
                }
            }
            if root.kind == Note.warning || root.kind == Note.notice: IconButton {
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                shape: Icons.clear;
                label: "Close";
                clicked => {
                    root.closed = true;
                }
            }
        }
        Timer {
            interval: 3s;
            running: root.kind == Note.brief && parent.shown;
            triggered => {
                root.closed = true;
            }
        }
    }
    if root.clips.length == 0: Art {
        pieces: root.art;
        area: "start";
        light: root.light;
    }
    if root.clips.length == 0: VerticalLayout {
        alignment: center;
        spacing: 14px;
        Text {
            text: "Drop clips here";
            color: Theme.muted;
            font-size: 16px;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Button {
                height: 30px;
                text: "Add clips";
                main: true;
                clicked => {
                    root.add-clips();
                }
            }
        }
    }
}
