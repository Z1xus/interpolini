export enum Note {
    sticky,
    brief,
    warning,
    notice,
}

export enum Mode {
    render,
    copy,
    munch,
}

export struct Munch {
    amount: int,
    // 0 keeps the rate of the clip
    fps: int,
    fry: int,
    loud: int,
}

export struct Clip {
    name: string,
    state: string,
    progress: float,
    at: float,
    track: int,
    kept: float,
    length: float,
    cut-in: float,
    cut-out: float,
    speed: float,
    // an audio clip sits on an audio track, and clips from one file share a link
    audio: bool,
    link: int,
    // selected together with other clips
    picked: bool,
    thumbs: [image],
    keys: [[float]],
    waves: [image],
    still: bool,
    // the width of the picture for a height of 1
    ratio: float,
    // the place of the picture on the canvas, see Place in the core
    x: float,
    y: float,
    zoom-x: float,
    zoom-y: float,
    crop-left: float,
    crop-top: float,
    crop-right: float,
    crop-bottom: float,
    // decibels
    gain: float,
    // seconds
    fade-in: float,
    fade-out: float,
    // the seconds of the crossfade with the clip before this one
    cross: float,
    // the curves of the fade in, of the fade out and of the crossfade
    ease-in: string,
    ease-out: string,
    ease-cross: string,
    // the crossfades that this clip is in now, at its start and at its end
    cross-in: float,
    cross-out: float,
    // the curve of the crossfade at its end
    ease-after: string,
    // other clips are from the same file
    paired: bool,
}

export struct Family {
    name: string,
    themes: [string],
    // the short name of each theme in the family
    labels: [string],
}

export struct Ghost {
    at: float,
    length: float,
    track: int,
    audio: bool,
}

export struct Lane {
    name: string,
    title: string,
    y: length,
    height: length,
    muted: bool,
}

export struct Settings {
    dedup: bool,
    dedup-repeats: float,
    pre: bool,
    pre-fps: string,
    interpolate: bool,
    engine: string,
    interpolation-fps: string,
    speed: string,
    tuning: string,
    algorithm: string,
    half: bool,
    backend: string,
    model: string,
    mask: bool,
    mask-method: string,
    mask-peel: float,
    mask-limit: float,
    mask-edge: float,
    mask-tolerance: float,
    mask-image: string,
    mask-soft: float,
    blend: bool,
    blend-fps: int,
    intensity: float,
    gamma: float,
    weighting: string,
    custom: string,
    grade: bool,
    brightness: float,
    contrast: float,
    saturation: float,
    hue: float,
    lut: string,
    upscale: bool,
    resolution: string,
    method: string,
    codec: string,
    encoder: string,
    target: string,
    quality: float,
    size: int,
    effort: string,
    container: string,
    audio: string,
    options: string,
}

export struct Sections {
    dedup: bool,
    pre: bool,
    interpolation: bool,
    masking: bool,
    blending: bool,
    color: bool,
    upscale: bool,
    output: bool,
}

export struct Recent {
    name: string,
    folder: string,
    path: string,
}

export struct Prefs {
    projects: bool,
    // minutes, 0 is off
    autosave: int,
    ask-save: bool,
    reopen: bool,
    confirm-delete: bool,
    folder: string,
    preset: string,
    // megabytes, 0 is automatic
    memory: int,
    // 1 fits the picture in the preview
    zoom: float,
    snapping: bool,
    autofit: bool,
    ripple: bool,
    scrolling: string,
    secret: bool,
}

export struct MaskTile {
    name: string,
    path: string,
    picture: image,
}

export struct Tile {
    x: int,
    y: int,
    width: int,
    height: int,
    picture: image,
}

export global Masks {
    in property <[MaskTile]> list;
    in property <image> hover;
    // -1 when the clip is not at the playhead
    in property <int> clip: -1;
    in property <bool> editing;
    in property <bool> undoable;
    in property <bool> redoable;
    in property <int> width;
    in property <int> height;
    in property <[Tile]> tiles;
    in property <string> opened;
    in-out property <string> name;
    in-out property <string> tool: "brush";
    in-out property <string> mode: "paint";
    in-out property <float> size: 40;
    out property <float> brush-max: max(100, round(self.height / 4));
    callback scan();
    callback show(string);
    callback add();
    callback remove(string);
    callback rename(string, string);
    callback duplicate(string);
    pure callback found([MaskTile], string) -> bool;
    callback draw();
    callback edit(string);
    callback stroke(x: float, y: float, erase: bool, first: bool);
    callback shape(x0: float, y0: float, x1: float, y1: float, erase: bool, ellipse: bool);
    callback done();
    callback undo();
    callback redo();
    callback clear();
    callback invert();
    callback save();
    callback leave();
}
