import { Action, Art, Clock, IconButton, Icons, MenuItem, MenuPopup, MenuRow, MenuSeparator, MenuSlider, Piece, Popups, Segment, Theme } from "widgets.slint";
import { Clip, Ghost, Lane } from "types.slint";

global Curves {
    // the path of a fade over a width, from the height a to the height b
    pure public function line(curve: string, wide: float, a: float, b: float) -> string {
        "M0 " + a + (curve == "smooth" ? "C" + wide / 3 + " " + a + " " + wide * 2 / 3 + " " + b + " " + wide + " " + b : curve == "ease in" ? "Q" + wide / 2 + " " + a + " " + wide + " " + b : curve == "ease out" ? "Q" + wide / 2 + " " + b + " " + wide + " " + b : "L" + wide + " " + b)
    }
}

component Fade inherits Rectangle {
    in property <bool> out;
    in property <string> curve;
    // the fade is there but not in use
    in property <bool> off;
    in property <bool> hot;
    // in pixels, so the corner is as wide as the fade
    property <float> wide: self.width / 1px;
    property <float> high: self.height / 1px;
    property <string> line: Curves.line(root.curve, root.wide, root.out ? 0 : root.high, root.out ? root.high : 0);
    Path {
        viewbox-width: root.wide;
        viewbox-height: root.high;
        commands: root.line + (root.out ? "V0z" : "H0z");
        fill: root.off ? transparent : Theme.void.with-alpha(0.5);
    }
    Path {
        viewbox-width: root.wide;
        viewbox-height: root.high;
        commands: root.line;
        stroke: root.off ? Theme.faint.with-alpha(0.7) : root.hot ? Theme.ink : Theme.ink.with-alpha(0.55);
        stroke-width: 1px;
    }
}

component Cross inherits Rectangle {
    in property <bool> out;
    in property <string> curve;
    in property <length> span;
    in property <length> hidden;
    property <float> wide: root.span / 1px * 2;
    property <float> high: self.height / 1px;
    property <string> fall: Curves.line(root.curve, root.wide, 0, root.high);
    property <string> rise: Curves.line(root.curve, root.wide, root.high, 0);
    background: Theme.rack.with-alpha(0.5);
    clip: true;
    // the curves go over the whole crossfade, and each of the two clips shows its half
    Rectangle {
        x: (root.out ? 0 : -root.span) - root.hidden;
        width: root.span * 2;
        Path {
            viewbox-width: root.wide;
            viewbox-height: root.high;
            commands: root.fall + "H0z";
            fill: Theme.ink.with-alpha(0.08);
        }
        Path {
            viewbox-width: root.wide;
            viewbox-height: root.high;
            commands: root.rise + "V" + root.high + "z";
            fill: Theme.accent.with-alpha(0.14);
        }
        Path {
            viewbox-width: root.wide;
            viewbox-height: root.high;
            commands: root.fall;
            stroke: Theme.ink.with-alpha(0.7);
            stroke-width: 1px;
        }
        Path {
            viewbox-width: root.wide;
            viewbox-height: root.high;
            commands: root.rise;
            stroke: Theme.accent;
            stroke-width: 1px;
        }
    }
}

component Crossing inherits VerticalLayout {
    in property <Clip> item;
    callback tune(float);
    callback curve(string);
    MenuSlider {
        text: "Crossfade";
        maximum: 5;
        value: root.item.cross;
        shown: round(self.value * 10) / 10 + " s";
        changed(value) => {
            root.tune(value);
        }
    }
    MenuRow {
        text: "Curve";
        Segment {
            horizontal-stretch: 1;
            label: "Crossfade curve";
            options: ["linear", "smooth", "ease in", "ease out"];
            value: root.item.ease-cross;
            changed(value) => {
                root.curve(value);
            }
        }
    }
}

export component Timeline inherits Rectangle {
    in-out property <[Clip]> clips;
    in property <bool> copying;
    in property <bool> snapping;
    in property <bool> ripple;
    callback toggle();
    in property <float> snapped: -1;
    in property <[Lane]> video;
    in property <[Lane]> audio;
    in property <[Ghost]> ghosts;
    in property <int> selected;
    in property <int> link;
    // the height of all tracks together
    in property <length> content;
    in property <[Piece]> art;
    in property <bool> light;
    in property <float> extent;
    in property <float> seconds;
    in-out property <float> position;
    callback seek();
    callback scrub-start();
    callback scrub-done();
    callback select(int);
    // adds a clip to the selected ones, or takes it out
    callback extend(int);
    callback range(int);
    callback lasso-start(bool);
    callback lasso(float, float, length, length);
    callback lasso-end();
    callback gap(float, length) -> bool;
    callback close-gap(float, length);
    // the clip, the time under the pointer, and if the clip moves without the other clips of its file
    callback grab(int, float, bool);
    callback drag(float, length, float, bool);
    callback release();
    callback trim-start();
    // the clip, how near in seconds an edge must be to hold it, and if the clip next to it stays as it is
    callback trimmed(int, float, bool, bool);
    // the clip, a setting and its value, and if the other clips of the file stay as they are
    callback tune(int, string, float, bool);
    // the clip, the fade, its curve, and if the other clips of the file stay as they are
    callback curve(int, string, string, bool);
    callback retime(int, float);
    // the clip that starts where this edge of a clip touches another clip, or -1
    callback joint(int, bool) -> int;
    callback mark(string);
    callback select-track(bool, int);
    callback remove-clip();
    callback ripple-clip();
    callback replace-clip(int);
    property <int> chosen;
    // with alt the menu is for one clip, without the other clips of its file
    property <bool> solo;
    property <int> edge;
    property <bool> joined;
    // 0 clip, 1 crossfade, 2 fade in, 3 fade out, 4 both fades
    function open(index: int, x: length, y: length, kind: int, solo: bool) {
        root.chosen = index;
        root.solo = solo;
        root.menu-x = x - root.absolute-position.x;
        root.menu-y = y - root.absolute-position.y;
        root.edge = root.copying ? 0 : kind;
        root.joined = kind == 4 && !root.copying && root.joint(index, true) >= 0;
        if kind == 1 && root.copying {
            return;
        }
        if kind == 1 {
            join.show();
        } else {
            menu.show();
        }
    }
    property <length> menu-x;
    property <length> menu-y;
    property <bool> lane-audio;
    property <int> lane-index;
    property <bool> shown: join.is-open || menu.is-open || hole.is-open || lane-menu.is-open;
    changed shown => {
        Popups.open += root.shown ? 1 : -1;
    }
    pure function lane-middle(audio: bool, index: int) -> length {
        root.absolute-position.y + root.ruler + (audio ? root.audio[index].y - root.under + root.audio[index].height / 2 : root.video[index].y - root.over + root.video[index].height / 2)
    }
    function open-lane(audio: bool, index: int, x: length, y: length) {
        root.lane-audio = audio;
        root.lane-index = index;
        root.menu-x = x - root.absolute-position.x;
        root.menu-y = y - root.absolute-position.y;
        lane-menu.show();
    }
    public function open-selected() {
        if root.selected < 0 {
            return;
        }
        let clip = root.clips[root.selected];
        root.open(root.selected, clamp(inner.absolute-position.x + clip.at / root.extent * inner.width + 12px, area.absolute-position.x + 8px, area.absolute-position.x + area.width - 8px), clamp(root.lane-middle(clip.audio, clip.track), root.absolute-position.y + root.ruler, root.absolute-position.y + root.height - 8px), 4, false);
    }
    public function open-track() {
        let audio = root.selected >= 0 && root.clips[root.selected].audio;
        let index = root.selected >= 0 ? root.clips[root.selected].track : 0;
        root.open-lane(audio, index, root.absolute-position.x + 24px, clamp(root.lane-middle(audio, index), root.absolute-position.y + root.ruler, root.absolute-position.y + root.height - 8px));
    }
    property <float> gap-time;
    property <length> gap-depth;
    pure function slack(shift: bool) -> float {
        shift == root.snapping ? 0 : 8px / inner.width * root.extent
    }
    // the clip whose edge is under the pointer, and if it is its start
    property <int> held: -1;
    property <bool> held-head;
    // a clip that touches that edge shows its own edge too, a trim moves the two
    pure function touches(index: int, head: bool) -> bool {
        root.held >= 0 && root.held != index && head != root.held-head && root.clips[index].audio == root.clips[root.held].audio && root.clips[index].track == root.clips[root.held].track && abs((head ? root.clips[index].at : root.clips[index].at + root.clips[index].kept) - (root.held-head ? root.clips[root.held].at : root.clips[root.held].at + root.clips[root.held].kept)) < 0.002
    }
    callback trim-done();
    callback lane-height(bool, int, length);
    callback lane-wheel(length, length);
    callback add-lane(bool);
    callback remove-lane(bool, int);
    callback mute-lane(int);
    property <length> gutter: 150px;
    property <length> ruler: 24px;
    property <float> zoom: 1;
    property <float> scroll;
    // the video tracks and the audio tracks are two stacks, which meet at the split line
    property <length> pane: root.height - root.ruler;
    property <length> upper: root.audio.length > 0 ? root.audio[0].y : root.content;
    property <length> lower: root.content - root.upper;
    property <length> spare: root.pane - root.content;
    // the split starts with the tracks in the middle, or with a share for each stack when they do not fit
    property <length> rest: root.upper + (root.spare > 0 ? root.spare / 2 : root.spare * (root.upper / max(1px, root.content)));
    property <length> nudge;
    property <length> divide: clamp(root.rest + root.nudge, min(24px, root.upper), root.pane - min(24px, root.lower));
    // how far the wheel moved each stack away from the split, when the stack does not fit
    property <length> up;
    property <length> down;
    property <length> rise: clamp(root.up, 0px, max(0px, root.upper - root.divide));
    property <length> sink: clamp(root.down, 0px, max(0px, root.lower - root.pane + root.divide));
    // what a depth in the tracks is higher than its place on the screen, for video and for audio
    property <length> over: root.upper - root.divide - root.rise;
    property <length> under: root.upper - root.divide + root.sink;
    // the playhead as a part of the full width
    property <float> head: root.position * root.seconds / root.extent;
    // a rectangle wider than 32767px panics the software renderer, so only the part in view is drawn
    property <length> left: root.scroll * area.width * root.zoom;
    // the distance between two time labels, about 90px apart
    property <float> raw: root.extent / max(1, area.width * root.zoom / 90px);
    property <float> step: raw <= 1 ? 1 : raw <= 2 ? 2 : raw <= 5 ? 5 : raw <= 10 ? 10 : raw <= 15 ? 15 : raw <= 30 ? 30 : raw <= 60 ? 60 : raw <= 120 ? 120 : raw <= 300 ? 300 : ceil(raw / 600) * 600;
    function pick(x: length) {
        root.position = clamp(x / (area.width * root.zoom) * root.extent / root.seconds, 0, 1);
        root.seek();
    }
    function jump(time: float) {
        root.scrub-start();
        root.position = clamp(time / max(0.001, root.seconds), 0, 1);
        root.seek();
        root.scrub-done();
    }
    public function magnify(factor: float) {
        root.grow(factor, root.head);
    }
    public function stretch(factor: float) {
        root.zoom = min(root.zoom * factor, 200);
        root.scroll = root.scroll / factor;
    }
    public function reset() {
        root.zoom = 1;
        root.scroll = 0;
    }
    // the time and the depth below the ruler of a point in the window
    public pure function time-at(x: length) -> float {
        (x - inner.absolute-position.x) / inner.width * root.extent
    }
    public pure function depth-at(y: length) -> length {
        root.depth(y - area.absolute-position.y - root.ruler)
    }
    pure function depth(y: length) -> length {
        y + (y < root.divide ? root.over : root.under)
    }
    pure function fits(y: length) -> bool {
        y < root.divide ? root.upper <= root.divide : root.lower <= root.pane - root.divide
    }
    property <bool> loose: root.spare > 0 && root.upper <= root.divide && root.lower <= root.pane - root.divide;
    // the wheel moves a stack that does not fit, or the two stacks together when the panel has room
    function roll(y: length, delta: length) {
        if root.fits(y) {
            root.nudge = clamp(root.divide + delta, root.upper, root.pane - root.lower) - root.rest;
        } else if y < root.divide {
            root.up = clamp(root.rise + delta, 0px, root.upper - root.divide);
        } else {
            root.down = clamp(root.sink - delta, 0px, root.lower - root.pane + root.divide);
        }
    }
    function grow(factor: float, at: float) {
        root.scroll = at - (at - root.scroll) * root.zoom / clamp(root.zoom * factor, 0.1, 200);
        root.zoom = clamp(root.zoom * factor, 0.1, 200);
        root.scroll = clamp(root.scroll, 0, max(0, 1 - 1 / root.zoom));
    }
    function wheel(event: PointerScrollEvent, x: length, y: length) {
        if event.modifiers.alt {
            root.lane-wheel(root.depth(y), event.delta-y + event.delta-x);
        } else if event.modifiers.control {
            // the time under the pointer stays under the pointer
            root.grow(event.delta-y > 0 ? 1.25 : 0.8, x / inner.width);
        } else if event.modifiers.shift || (root.fits(y) && !root.loose) {
            root.scroll = clamp(root.scroll - (event.delta-y + event.delta-x) / inner.width, 0, max(0, 1 - 1 / root.zoom));
        } else {
            root.roll(y, event.delta-y);
        }
    }
    property <float> parked;
    // the view follows the playhead when it leaves
    changed position => {
        let moved = abs(root.position * root.seconds - root.parked) > 0.001;
        root.parked = root.position * root.seconds;
        if moved && (root.head < root.scroll || root.head > root.scroll + 1 / root.zoom) {
            root.scroll = clamp(root.head - 0.1 / root.zoom, 0, max(0, 1 - 1 / root.zoom));
        }
    }
    max-width: 100000px;
    background: Theme.rack;
    clip: true;

    join := MenuPopup {
        x: root.menu-x;
        y: root.menu-y - self.height;
        close-policy: close-on-click-outside;
        Crossing {
            item: root.clips[root.chosen];
            tune(value) => {
                root.tune(root.chosen, "crossfade", value, root.solo);
            }
            curve(value) => {
                root.curve(root.chosen, "crossfade", value, root.solo);
            }
        }
    }

    menu := MenuPopup {
        x: root.menu-x;
        // the timeline is at the bottom of the window, so the menu opens upward
        y: root.menu-y - self.height;
        close-policy: close-on-click-outside;
        for side in root.edge == 4 ? [2, 3] : root.edge > 1 ? [root.edge] : []: VerticalLayout {
            MenuSlider {
                text: side == 3 ? "Fade out" : "Fade in";
                maximum: 5;
                value: side == 3 ? root.clips[root.chosen].fade-out : root.clips[root.chosen].fade-in;
                shown: round(self.value * 10) / 10 + " s";
                changed(value) => {
                    root.tune(root.chosen, side == 3 ? "fade out" : "fade in", value, root.solo);
                }
            }
            MenuRow {
                text: "Curve";
                Segment {
                    horizontal-stretch: 1;
                    label: side == 3 ? "Fade out curve" : "Fade in curve";
                    options: ["linear", "smooth", "ease in", "ease out"];
                    value: side == 3 ? root.clips[root.chosen].ease-out : root.clips[root.chosen].ease-in;
                    changed(value) => {
                        root.curve(root.chosen, side == 3 ? "fade out" : "fade in", value, root.solo);
                    }
                }
            }
        }
        if root.joined: Crossing {
            item: root.clips[root.chosen];
            tune(value) => {
                root.tune(root.chosen, "crossfade", value, root.solo);
            }
            curve(value) => {
                root.curve(root.chosen, "crossfade", value, root.solo);
            }
        }
        if !root.clips[root.chosen].still && !root.copying: MenuSlider {
            text: "Speed";
            minimum: -3;
            maximum: 3;
            step: 0.05;
            value: log(root.clips[root.chosen].speed, 2);
            shown: round(pow(2, self.value) * 100) / 100 + "x";
            changed(value) => {
                root.retime(root.chosen, round(pow(2, value) * 100) / 100);
            }
        }
        if root.clips[root.chosen].audio && !root.copying: MenuSlider {
            text: "Gain";
            minimum: -24;
            maximum: 24;
            step: 0.5;
            value: root.clips[root.chosen].gain;
            shown: (self.value > 0 ? "+" : "") + round(self.value * 10) / 10 + " dB";
            changed(value) => {
                root.tune(root.chosen, "gain", value, root.solo);
            }
        }
        if (!root.clips[root.chosen].still || root.clips[root.chosen].audio) && !root.copying: MenuSeparator { }
        MenuItem {
            text: "Split";
            hint: "S";
            clicked => {
                root.mark("split");
                menu.close();
            }
        }
        MenuItem {
            text: "Replace…";
            clicked => {
                root.replace-clip(root.chosen);
                menu.close();
            }
        }
        MenuItem {
            text: "Remove clip";
            hint: root.ripple ? "Shift Delete" : "Delete";
            clicked => {
                root.remove-clip();
                menu.close();
            }
        }
        MenuItem {
            text: "Ripple delete";
            hint: root.ripple ? "Delete" : "Shift Delete";
            clicked => {
                root.ripple-clip();
                menu.close();
            }
        }
    }

    hole := MenuPopup {
        x: root.menu-x;
        y: root.menu-y - self.height;
        close-policy: close-on-click-outside;
        MenuItem {
            text: "Ripple delete";
            clicked => {
                root.close-gap(root.gap-time, root.gap-depth);
                hole.close();
            }
        }
    }

    lane-menu := MenuPopup {
        x: root.menu-x;
        y: root.menu-y - self.height;
        close-policy: close-on-click-outside;
        MenuItem {
            text: "Add track";
            clicked => {
                root.add-lane(root.lane-audio);
                lane-menu.close();
            }
        }
        if root.lane-audio: MenuItem {
            text: "Mute track";
            toggle: true;
            checked: root.audio[root.lane-index].muted;
            clicked => {
                root.mute-lane(root.lane-index);
                lane-menu.close();
            }
        }
        MenuItem {
            text: "Select clips on track";
            clicked => {
                root.select-track(root.lane-audio, root.lane-index);
                lane-menu.close();
            }
        }
        MenuSeparator { }
        MenuItem {
            text: "Remove track";
            enabled: root.lane-audio || root.video.length > 1;
            clicked => {
                root.remove-lane(root.lane-audio, root.lane-index);
                lane-menu.close();
            }
        }
    }

    Art {
        pieces: root.art;
        area: "timeline";
        light: root.light;
    }

    Rectangle {
        x: 0;
        y: root.ruler;
        width: root.gutter;
        height: root.height - root.ruler;
        clip: true;
        TouchArea {
            scroll-event(event) => {
                if event.modifiers.alt {
                    root.lane-wheel(root.depth(self.mouse-y), event.delta-y + event.delta-x);
                } else if !root.fits(self.mouse-y) || root.loose {
                    root.roll(self.mouse-y, event.delta-y);
                }
                accept
            }
        }
        Rectangle {
            y: 0;
            height: root.divide;
            clip: true;
            for lane[index] in root.video: Rectangle {
                y: lane.y - root.over;
                height: lane.height;
                accessible-role: groupbox;
                accessible-label: "Video track " + lane.name;
                accessible-action-default => {
                    root.open-lane(false, index, self.absolute-position.x + 24px, self.absolute-position.y + self.height / 2);
                }
                TouchArea {
                    pointer-event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                            root.open-lane(false, index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
                Text {
                    x: 12px;
                    text: lane.name;
                    color: Theme.muted;
                    font-size: 11px;
                    font-family: "monospace";
                    vertical-alignment: center;
                    accessible-role: none;
                }
                if root.video.length > 1: Action {
                    x: parent.width - self.width - 12px;
                    width: self.preferred-width;
                    text: "×";
                    accessible: "Remove track " + lane.name;
                    context(x, y) => {
                        root.open-lane(false, index, x, y);
                    }
                    clicked => {
                        root.remove-lane(false, index);
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.seam;
                }
                Rectangle {
                    y: 0;
                    height: 3px;
                    background: size.has-hover || size.pressed ? Theme.accent : transparent;
                }
                size := TouchArea {
                    // the panel grows upward with the track, so the height counts from where the drag started
                    property <length> anchor;
                    property <length> base;
                    y: 0;
                    height: 9px;
                    mouse-cursor: row-resize;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            root.open-lane(false, index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        } else if event.kind == PointerEventKind.down {
                            self.anchor = self.absolute-position.y + self.mouse-y;
                            self.base = lane.height;
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.lane-height(false, index, self.base - (self.absolute-position.y + self.mouse-y - self.anchor));
                        }
                    }
                }
            }
        }
        Rectangle {
            y: root.divide;
            height: parent.height - root.divide;
            clip: true;
            for lane[index] in root.audio: Rectangle {
                y: lane.y - root.under - root.divide;
                height: lane.height;
                accessible-role: groupbox;
                accessible-label: "Audio track " + lane.name + (lane.muted ? ", muted" : "");
                accessible-action-default => {
                    root.open-lane(true, index, self.absolute-position.x + 24px, self.absolute-position.y + self.height / 2);
                }
                TouchArea {
                    pointer-event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                            root.open-lane(true, index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
                HorizontalLayout {
                    x: 12px;
                    width: parent.width - 24px;
                    spacing: 8px;
                    Text {
                        text: lane.name;
                        color: lane.muted ? Theme.faint : Theme.muted;
                        font-size: 11px;
                        font-family: "monospace";
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    Action {
                        text: "M";
                        accessible: "Mute track " + lane.name;
                        toggle: true;
                        context(x, y) => {
                            root.open-lane(true, index, x, y);
                        }
                        active: lane.muted;
                        clicked => {
                            root.mute-lane(index);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Action {
                        text: "×";
                        accessible: "Remove track " + lane.name;
                        context(x, y) => {
                            root.open-lane(true, index, x, y);
                        }
                        clicked => {
                            root.remove-lane(true, index);
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.seam;
                }
                Rectangle {
                    y: 0;
                    height: 3px;
                    background: grow.has-hover || grow.pressed ? Theme.accent : transparent;
                }
                grow := TouchArea {
                    // the panel grows upward with the track, so the height counts from where the drag started
                    property <length> anchor;
                    property <length> base;
                    y: 0;
                    height: 9px;
                    mouse-cursor: row-resize;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            root.open-lane(true, index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        } else if event.kind == PointerEventKind.down {
                            self.anchor = self.absolute-position.y + self.mouse-y;
                            self.base = lane.height;
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.lane-height(true, index, self.base - (self.absolute-position.y + self.mouse-y - self.anchor));
                        }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        x: 6px;
        y: 0;
        width: root.gutter - 18px;
        height: root.ruler;
        spacing: 10px;
        IconButton {
            width: 24px;
            height: 24px;
            shape: Icons.magnet;
            label: "Snapping";
            keys: ["N"];
            toggle: true;
            active: root.snapping;
            clicked => {
                root.toggle();
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Action {
            text: "+V";
            accessible: "Add video track";
            clicked => {
                root.add-lane(false);
            }
        }
        Action {
            text: "+A";
            accessible: "Add audio track";
            clicked => {
                root.add-lane(true);
            }
        }
    }
    Rectangle {
        x: root.gutter - 1px;
        width: 1px;
        background: Theme.seam;
    }

    area := Rectangle {
        x: root.gutter;
        width: root.width - root.gutter;
        clip: true;

        inner := Rectangle {
            x: -root.scroll * self.width;
            width: area.width * root.zoom;

            Rectangle {
                y: root.ruler;
                // the tracks and the ruler go on after the last clip, when the view is wider
                x: 0;
                width: max(parent.width, area.width);
                height: parent.height - root.ruler;
                clip: true;
                accessible-role: list;
                accessible-label: "Clips";

                empty := TouchArea {
                    property <bool> boxed;
                    property <length> from-x;
                    property <length> from-y;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            let add = event.button == PointerEventButton.left && (event.modifiers.control || event.modifiers.shift);
                            if !add {
                                root.select(-1);
                            }
                            if event.button == PointerEventButton.left {
                                self.boxed = true;
                                self.from-x = self.mouse-x;
                                self.from-y = self.mouse-y;
                                root.lasso-start(add);
                            } else if event.button == PointerEventButton.right && root.gap(self.mouse-x / inner.width * root.extent, root.depth(self.mouse-y)) {
                                root.gap-time = self.mouse-x / inner.width * root.extent;
                                root.gap-depth = root.depth(self.mouse-y);
                                root.menu-x = self.absolute-position.x + self.mouse-x - root.absolute-position.x;
                                root.menu-y = self.absolute-position.y + self.mouse-y - root.absolute-position.y;
                                hole.show();
                            }
                        } else if event.kind == PointerEventKind.up && self.boxed {
                            self.boxed = false;
                            root.lasso-end();
                        }
                    }
                    moved => {
                        if self.boxed {
                            root.lasso(min(self.from-x, self.mouse-x) / inner.width * root.extent, max(self.from-x, self.mouse-x) / inner.width * root.extent, root.depth(min(self.from-y, self.mouse-y)), root.depth(max(self.from-y, self.mouse-y)));
                        }
                    }
                    scroll-event(event) => {
                        root.wheel(event, self.mouse-x, self.mouse-y);
                        accept
                    }
                }
                for lane in root.video: Rectangle {
                    visible: self.y < root.divide;
                    x: root.left;
                    width: area.width;
                    y: lane.y + lane.height - 1px - root.over;
                    height: 1px;
                    background: Theme.seam.with-alpha(0.6);
                }
                for lane in root.audio: Rectangle {
                    visible: self.y >= root.divide;
                    x: root.left;
                    width: area.width;
                    y: lane.y + lane.height - 1px - root.under;
                    height: 1px;
                    background: Theme.seam.with-alpha(0.6);
                }

                for clip[index] in root.clips: Rectangle {
                    property <bool> current: index == root.selected;
                    property <bool> linked: clip.link == root.link;
                    property <string> spoken: clip.name + ", " + (clip.audio ? "audio" : clip.still ? "image" : "video") + ", " + lane.name + ", from " + Clock.text(clip.at) + " to " + Clock.text(clip.at + clip.kept) + (clip.speed == 1 ? "" : ", speed " + round(clip.speed * 100) / 100 + "x") + (clip.state == "" ? "" : ", " + clip.state.to-lowercase()) + (clip.fade-in > 0 ? ", fade in " + round(clip.fade-in * 10) / 10 + " s" : "") + (clip.fade-out > 0 ? ", fade out " + round(clip.fade-out * 10) / 10 + " s" : "") + (clip.cross-in > 0 ? ", crossfade in " + round(clip.cross-in * 10) / 10 + " s" : "") + (clip.cross-out > 0 ? ", crossfade out " + round(clip.cross-out * 10) / 10 + " s" : "");
                    property <Lane> lane: clip.audio ? root.audio[clip.track] : root.video[clip.track];
                    // a trim starts from these, so the edge follows the pointer and not the layout
                    property <length> anchor;
                    property <float> base;
                    property <float> origin;
                    // with alt a trim leaves the clip next to this one as it is
                    property <bool> alone;
                    property <length> before: clip.cross-in / 2 / root.extent * inner.width;
                    property <length> after: clip.cross-out / 2 / root.extent * inner.width;
                    property <int> grip: head.has-hover || head.pressed ? 1 : tail.has-hover || tail.pressed ? 2 : 0;
                    changed grip => {
                        if self.grip > 0 {
                            root.held = index;
                            root.held-head = self.grip == 1;
                        } else if root.held == index {
                            root.held = -1;
                        }
                    }
                    // the width of the whole source at this scale
                    property <length> whole: clip.length / root.extent * inner.width;
                    property <length> start: clip.at / root.extent * inner.width;
                    property <length> full: clip.kept / root.extent * inner.width;
                    property <length> fin: min(full - 2px, clip.fade-in / root.extent * inner.width);
                    property <length> fout: min(full - 2px, clip.fade-out / root.extent * inner.width);
                    property <bool> hot-in: fade-in.has-hover || fade-in.pressed;
                    property <bool> hot-out: fade-out.has-hover || fade-out.pressed;
                    property <length> reach: min(full / 3, 60px);
                    property <length> skip: clamp(root.left - 2px - start, 0, full);
                    property <length> shown: clamp(root.left + area.width + 2px - start, 0, full) - skip;
                    // the keyframes are 3px apart or more
                    property <int> detail: clamp(ceil(log(max(1.0, 3px * clip.length * clip.speed / (0.025 * max(1px, whole))), 2)), 0, max(0, clip.keys.length - 1));
                    pure function time(x: length) -> float {
                        (x - inner.absolute-position.x) / inner.width * root.extent
                    }
                    // a clip shows only in the stack of its kind
                    y: clip.audio ? root.divide : 0;
                    height: clip.audio ? root.pane - root.divide : root.divide;
                    clip: true;
                    // the selected clip and the clips of its file draw over the others
                    z: current ? 2 : linked ? 1 : 0;

                    Rectangle {
                        x: start;
                        y: lane.y + 2px - (clip.audio ? root.under + root.divide : root.over);
                        width: full;
                        height: lane.height - 4px;

                        Rectangle {
                            x: 1px + skip;
                            width: max(0px, shown - 2px);
                            // a solid base, so a clip under this one does not show through
                            background: clip.audio ? Theme.rack : Theme.raised;
                            accessible-role: list-item;
                            accessible-label: spoken;
                            accessible-item-selectable: true;
                            accessible-item-selected: current || clip.picked;
                            accessible-item-index: index;
                            accessible-item-count: root.clips.length;
                            accessible-action-default => {
                                root.select(index);
                            }
                            border-width: 1px;
                            border-color: current || clip.picked ? Theme.accent : linked ? Theme.accent.with-alpha(0.5) : Theme.seam;
                            opacity: root.copying && clip.still ? 0.3 : 1;
                            clip: true;
                            if clip.audio: Rectangle {
                                background: lane.muted ? Theme.void.with-alpha(0.3) : Theme.ghost;
                            }
                            if clip.still: Image {
                                x: 3px;
                                y: 15px;
                                width: self.height * clip.ratio;
                                height: parent.height - 17px;
                                source: clip.thumbs[0];
                                accessible-role: none;
                            }
                            if !clip.audio && !clip.still: Rectangle {
                                x: -clip.cut-in * whole - skip;
                                y: 15px;
                                width: whole;
                                height: parent.height - 16px;
                                for thumb[at] in clip.thumbs: Image {
                                    x: at * whole / clip.thumbs.length;
                                    width: whole / clip.thumbs.length;
                                    height: parent.height;
                                    source: thumb;
                                    image-fit: cover;
                                    accessible-role: none;
                                }
                            }
                            if clip.audio: Image {
                                x: -clip.cut-in * whole - skip;
                                width: whole;
                                height: parent.height * (root.copying ? 1 : pow(10, clip.gain / 20));
                                y: (parent.height - self.height) / 2;
                                source: clip.wave;
                                accessible-role: none;
                                image-fit: fill;
                                image-rendering: pixelated;
                                colorize: lane.muted ? Theme.faint : Theme.accent.with-alpha(0.7);
                            }
                            if (clip.fade-in > 0 || hot-in) && clip.cross-in == 0: Fade {
                                x: -skip;
                                width: clip.fade-in > 0 ? fin : 16px;
                                curve: clip.ease-in;
                                hot: hot-in;
                                off: root.copying;
                            }
                            if (clip.fade-out > 0 || hot-out) && clip.cross-out == 0: Fade {
                                x: full - 2px - self.width - skip;
                                width: clip.fade-out > 0 ? fout : 16px;
                                curve: clip.ease-out;
                                hot: hot-out;
                                off: root.copying;
                                out: true;
                            }
                            if clip.cross-in > 0: Cross {
                                opacity: root.copying ? 0.3 : 1;
                                x: 0;
                                width: clamp(before - skip, 0, parent.width);
                                span: before;
                                hidden: skip;
                                curve: clip.ease-cross;
                            }
                            if clip.cross-out > 0: Cross {
                                opacity: root.copying ? 0.3 : 1;
                                x: max(0px, full - 2px - after - skip);
                                width: max(0px, min(parent.width, full - 2px - skip) - self.x);
                                span: after;
                                hidden: self.x - (full - 2px - after - skip);
                                curve: clip.ease-after;
                                out: true;
                            }
                            if root.copying && !clip.audio && !clip.still: Rectangle {
                                y: parent.height - 11px;
                                height: 10px;
                                background: Theme.void.with-alpha(0.75);
                                Rectangle {
                                    // 1px for the border
                                    x: -clip.cut-in * whole - skip - 1px;
                                    width: whole;
                                    for key in clip.keys[detail]: Rectangle {
                                        x: key / clip.speed / clip.length * parent.width;
                                        y: 1px;
                                        width: 1px;
                                        height: 8px;
                                        background: Theme.ink.with-alpha(0.55);
                                    }
                                }
                            }
                            Rectangle {
                                x: 0;
                                width: clamp(clip.progress * (full - 2px) - skip, 0, parent.width);
                                background: Theme.accent.with-alpha(0.35);
                            }
                            Text {
                                x: 5px;
                                y: 1px;
                                width: parent.width - 10px;
                                height: 14px;
                                text: (clip.state == "" ? "" : clip.state + "  ") + (clip.speed == 1 ? "" : round(clip.speed * 100) / 100 + "x  ") + clip.name;
                                color: clip.state == "Done" ? Theme.ok : current || clip.state == "Missing" ? Theme.ink : Theme.muted;
                                font-size: 10px;
                                overflow: elide;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                            body := TouchArea {
                                property <bool> dragged;
                                property <length> from-x;
                                property <length> from-y;
                                mouse-cursor: move;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right {
                                        if event.kind == PointerEventKind.down {
                                            if !clip.picked {
                                                root.select(index);
                                            }
                                            // on a crossfade the menu is for the crossfade
                                            if clip.cross-in > 0 && self.mouse-x + skip < before {
                                                root.open(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 1, event.modifiers.alt);
                                            } else if clip.cross-out > 0 && self.mouse-x + skip > full - 2px - after {
                                                root.open(root.joint(index, false), self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 1, event.modifiers.alt);
                                            } else if self.mouse-x + skip < max(fin, reach) {
                                                root.open(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 2, event.modifiers.alt);
                                            } else if self.mouse-x + skip > full - 2px - max(fout, reach) {
                                                root.open(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 3, event.modifiers.alt);
                                            } else {
                                                root.open(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 0, event.modifiers.alt);
                                            }
                                        }
                                    } else if event.kind == PointerEventKind.down {
                                        if event.modifiers.control {
                                            root.extend(index);
                                        } else if event.modifiers.shift {
                                            root.range(index);
                                        } else if !clip.picked {
                                            root.select(index);
                                        }
                                        self.dragged = false;
                                        self.from-x = self.absolute-position.x + self.mouse-x;
                                        self.from-y = self.absolute-position.y + self.mouse-y;
                                        root.grab(index, time(self.absolute-position.x + self.mouse-x), event.modifiers.alt);
                                    } else if event.kind == PointerEventKind.up {
                                        root.release();
                                        if !self.dragged && !event.modifiers.control && !event.modifiers.shift && clip.picked {
                                            root.select(index);
                                        }
                                    } else if event.kind == PointerEventKind.move && self.pressed {
                                        let x = self.absolute-position.x + self.mouse-x;
                                        let y = self.absolute-position.y + self.mouse-y;
                                        self.dragged = self.dragged || abs(x - self.from-x) >= 3px || abs(y - self.from-y) >= 3px;
                                        if self.dragged {
                                            root.drag(time(x), root.depth-at(y), root.slack(event.modifiers.shift), event.modifiers.control);
                                        }
                                    }
                                }
                                scroll-event(event) => {
                                    root.wheel(event, self.absolute-position.x + self.mouse-x - inner.absolute-position.x, self.absolute-position.y + self.mouse-y - area.absolute-position.y - root.ruler);
                                    accept
                                }
                            }
                        }

                        Rectangle {
                            x: 0;
                            width: 7px;
                            head := TouchArea {
                                mouse-cursor: col-resize;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right {
                                        if event.kind == PointerEventKind.down {
                                            if !clip.picked {
                                                root.select(index);
                                            }
                                            root.open(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, root.joint(index, true) >= 0 ? 1 : 2, event.modifiers.alt);
                                        }
                                    } else if event.kind == PointerEventKind.down {
                                        root.select(index);
                                        root.trim-start();
                                        alone = event.modifiers.alt;
                                        anchor = self.absolute-position.x + self.mouse-x;
                                        base = clip.cut-in;
                                        origin = clip.at;
                                    } else if event.kind == PointerEventKind.up {
                                        root.trim-done();
                                    } else if event.kind == PointerEventKind.move && self.pressed {
                                        // the end of the clip stays where it is
                                        clip.cut-in = clamp(base + (self.absolute-position.x + self.mouse-x - anchor) / whole, max(0, base - origin / clip.length), clip.cut-out - 0.1 / clip.length);
                                        clip.at = origin + (clip.cut-in - base) * clip.length;
                                        root.trimmed(index, root.slack(event.modifiers.shift), alone, event.modifiers.control);
                                    }
                                }
                            }
                            Rectangle {
                                x: 1px;
                                width: 3px;
                                background: head.has-hover || head.pressed || root.touches(index, true) ? Theme.accent : transparent;
                            }
                        }
                        Rectangle {
                            x: parent.width - self.width;
                            width: 7px;
                            tail := TouchArea {
                                mouse-cursor: col-resize;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right {
                                        if event.kind == PointerEventKind.down {
                                            if !clip.picked {
                                                root.select(index);
                                            }
                                            let next = root.joint(index, false);
                                            root.open(next >= 0 ? next : index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, next >= 0 ? 1 : 3, event.modifiers.alt);
                                        }
                                    } else if event.kind == PointerEventKind.down {
                                        root.select(index);
                                        root.trim-start();
                                        alone = event.modifiers.alt;
                                        anchor = self.absolute-position.x + self.mouse-x;
                                        base = clip.cut-out;
                                    } else if event.kind == PointerEventKind.up {
                                        root.trim-done();
                                    } else if event.kind == PointerEventKind.move && self.pressed {
                                        clip.cut-out = clamp(base + (self.absolute-position.x + self.mouse-x - anchor) / whole, clip.cut-in + 0.1 / clip.length, 1);
                                        root.trimmed(index, root.slack(event.modifiers.shift), alone, event.modifiers.control);
                                    }
                                }
                            }
                            Rectangle {
                                x: parent.width - 4px;
                                width: 3px;
                                background: tail.has-hover || tail.pressed || root.touches(index, false) ? Theme.accent : transparent;
                            }
                        }
                        // 15px is the title strip
                        fade-in := TouchArea {
                            x: max(0px, fin - 7px);
                            y: 0;
                            width: 14px;
                            height: 15px;
                            visible: !root.copying && full >= 40px && clip.cross-in == 0;
                            mouse-cursor: ew-resize;
                            pointer-event(event) => {
                                if event.button == PointerEventButton.right {
                                    if event.kind == PointerEventKind.down {
                                        if !clip.picked {
                                            root.select(index);
                                        }
                                        root.open(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 2, event.modifiers.alt);
                                    }
                                } else if event.kind == PointerEventKind.down {
                                    if !clip.picked {
                                        root.select(index);
                                    }
                                    anchor = self.absolute-position.x + self.mouse-x;
                                    base = clip.fade-in;
                                } else if event.kind == PointerEventKind.move && self.pressed {
                                    root.tune(index, "fade in", round(clamp(base + (self.absolute-position.x + self.mouse-x - anchor) / inner.width * root.extent, 0, min(5, clip.kept)) * 20) / 20, event.modifiers.alt);
                                }
                            }
                        }
                        fade-out := TouchArea {
                            x: parent.width - 14px - max(0px, fout - 7px);
                            y: 0;
                            width: 14px;
                            height: 15px;
                            visible: !root.copying && full >= 40px && clip.cross-out == 0;
                            mouse-cursor: ew-resize;
                            pointer-event(event) => {
                                if event.button == PointerEventButton.right {
                                    if event.kind == PointerEventKind.down {
                                        if !clip.picked {
                                            root.select(index);
                                        }
                                        root.open(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 3, event.modifiers.alt);
                                    }
                                } else if event.kind == PointerEventKind.down {
                                    if !clip.picked {
                                        root.select(index);
                                    }
                                    anchor = self.absolute-position.x + self.mouse-x;
                                    base = clip.fade-out;
                                } else if event.kind == PointerEventKind.move && self.pressed {
                                    root.tune(index, "fade out", round(clamp(base - (self.absolute-position.x + self.mouse-x - anchor) / inner.width * root.extent, 0, min(5, clip.kept)) * 20) / 20, event.modifiers.alt);
                                }
                            }
                        }
                        if fade-in.pressed: Rectangle {
                            x: fin + 4px;
                            y: 4px;
                            width: readout-in.preferred-width + 6px;
                            height: 14px;
                            background: Theme.raised;
                            readout-in := Text {
                                text: clip.fade-in.to-fixed(abs(clip.fade-in * 10 - round(clip.fade-in * 10)) < 0.01 ? 1 : 2) + " s";
                                color: Theme.ink;
                                font-size: 10px;
                                font-family: "monospace";
                                accessible-role: none;
                            }
                        }
                        if fade-out.pressed: Rectangle {
                            x: full - fout - 4px - self.width;
                            y: 4px;
                            width: readout-out.preferred-width + 6px;
                            height: 14px;
                            background: Theme.raised;
                            readout-out := Text {
                                text: clip.fade-out.to-fixed(abs(clip.fade-out * 10 - round(clip.fade-out * 10)) < 0.01 ? 1 : 2) + " s";
                                color: Theme.ink;
                                font-size: 10px;
                                font-family: "monospace";
                                accessible-role: none;
                            }
                        }
                    }
                }

                for ghost in root.ghosts: Rectangle {
                    property <[Lane]> lanes: ghost.audio ? root.audio : root.video;
                    property <Lane> lane: self.lanes[ghost.track];
                    visible: ghost.track < self.lanes.length;
                    property <length> from: ghost.at / root.extent * inner.width;
                    property <length> to: self.from + ghost.length / root.extent * inner.width;
                    x: max(self.from, root.left - 2px);
                    y: self.lane.y + 2px - (ghost.audio ? root.under : root.over);
                    width: max(0px, min(self.to, root.left + area.width + 2px) - self.x);
                    height: self.lane.height - 4px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    background: Theme.ghost;
                }

                if root.snapped >= 0: Rectangle {
                    x: root.snapped / root.extent * inner.width;
                    width: 1px;
                    z: 3;
                    background: Theme.accent;
                }

                if empty.boxed: Rectangle {
                    x: min(empty.from-x, empty.mouse-x);
                    y: min(empty.from-y, empty.mouse-y);
                    width: abs(empty.mouse-x - empty.from-x);
                    height: abs(empty.mouse-y - empty.from-y);
                    z: 3;
                    border-width: 1px;
                    border-color: Theme.accent;
                    background: Theme.accent.with-alpha(0.12);
                }

                // the line between video and audio moves the split, and the tracks keep their heights
                if root.audio.length > 0: Rectangle {
                    y: root.divide - 3px;
                    height: 6px;
                    Rectangle {
                        y: 2px;
                        height: 2px;
                        background: split.has-hover || split.pressed ? Theme.accent : transparent;
                    }
                    split := TouchArea {
                        property <length> anchor;
                        property <length> base;
                        mouse-cursor: row-resize;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                self.anchor = self.absolute-position.y + self.mouse-y;
                                self.base = root.divide;
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.nudge = clamp(self.base + self.absolute-position.y + self.mouse-y - self.anchor, min(24px, root.upper), root.pane - min(24px, root.lower)) - root.rest;
                            }
                        }
                    }
                }
            }

            // the ruler seeks, also over the clips
            Rectangle {
                y: 0;
                x: 0;
                width: max(parent.width, area.width);
                height: root.ruler;
                accessible-role: slider;
                accessible-label: "Playhead";
                accessible-value: Clock.text(root.position * root.seconds);
                accessible-value-minimum: 0;
                accessible-value-maximum: root.seconds;
                accessible-value-step: 1;
                accessible-action-increment => {
                    root.jump(root.position * root.seconds + 1);
                }
                accessible-action-decrement => {
                    root.jump(root.position * root.seconds - 1);
                }
                accessible-action-set-value(text) => {
                    root.jump(text.to-float());
                }
                Rectangle {
                    x: root.left;
                    width: area.width;
                    background: Theme.rack;
                }
                for index in floor(root.extent / root.zoom / root.step) + 2: Rectangle {
                    property <int> time: (floor(root.scroll * root.extent / root.step) + index) * root.step;
                    x: time / root.extent * inner.width;
                    y: 0;
                    width: 1px;
                    height: 6px;
                    background: Theme.seam;
                    Text {
                        x: 4px;
                        y: 5px;
                        text: Clock.text(time);
                        color: Theme.faint;
                        font-size: 10px;
                        font-family: "monospace";
                        accessible-role: none;
                    }
                }
                scrub := TouchArea {
                    mouse-cursor: ew-resize;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.scrub-start();
                            root.pick(self.mouse-x);
                        } else if event.kind == PointerEventKind.up {
                            root.scrub-done();
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.pick(self.mouse-x);
                        }
                    }
                    scroll-event(event) => {
                        root.wheel(event, self.mouse-x, self.mouse-y - root.ruler);
                        accept
                    }
                }
                if scrub.has-hover && !scrub.pressed: Rectangle {
                    property <float> time: scrub.mouse-x / inner.width * root.extent;
                    x: scrub.mouse-x;
                    width: 1px;
                    background: Theme.muted;
                    Rectangle {
                        x: 4px;
                        y: 4px;
                        width: label.preferred-width + 6px;
                        height: 14px;
                        background: Theme.raised;
                        label := Text {
                            text: Clock.text(time) + "." + floor(mod(time, 1) * 10);
                            color: Theme.ink;
                            font-size: 10px;
                            font-family: "monospace";
                            accessible-role: none;
                        }
                    }
                }
                Rectangle {
                    x: root.left;
                    width: area.width;
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.seam;
                }
            }

            Rectangle {
                x: min(root.head * inner.width, inner.width - 1px);
                width: 1px;
                background: Theme.accent;
                Path {
                    x: -3.5px;
                    y: 0;
                    width: 8px;
                    height: 5px;
                    viewbox-width: 8;
                    viewbox-height: 5;
                    commands: "M0 0h8L4 5z";
                    fill: Theme.accent;
                }
            }
        }

        if root.zoom > 1: Rectangle {
            x: root.scroll * area.width;
            y: area.height - 3px;
            width: area.width / root.zoom;
            height: 3px;
            background: Theme.muted;
        }
    }
}
