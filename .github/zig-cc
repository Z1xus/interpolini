#!/usr/bin/env bash
# super fragile bullshit
# the c and c++ compiler for macos on linux: zig with the sdk of apple, under the names cc and c++
# zig does not take some flags that ffmpeg, cmake and ncnn give to the linker of apple
args=()
for arg in "$@"; do
  case "$arg" in
    -Wl,-dynamic,-search_paths_first | -Wl,-single_module | -Wl,-read_only_relocs,suppress) ;;
    # zig wants a full version number where ffmpeg gives one number
    -Wl,-install_name,*) args+=("$(sed -E 's/(-compatibility_version,[0-9]+)$/\1.0.0/' <<< "$arg")") ;;
    # ncnn links a list of vulkan names that it finds itself when it runs, zig cannot take that list by its path
    -Wl,-weak_library,*) args+=("-Wl,-undefined,dynamic_lookup") ;;
    *) args+=("$arg") ;;
  esac
done
# without a sysroot: with one, zig also looks for the other library folders of a build inside the sdk
exec "$ZIG" "${0##*/}" -target "$ZIG_TARGET" -isystem "$SDKROOT/usr/include" \
  -iframework "$SDKROOT/System/Library/Frameworks" "-F$SDKROOT/System/Library/Frameworks" "-L$SDKROOT/usr/lib" "${args[@]}"
